---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Design de Plateformes SaaS - Florian Gertner Kilian" description="Expertise en conception d'interfaces complexes, tableaux de bord et plateformes SaaS." body_class="">
    <main class="flex-1 flex flex-col pt-32 pb-16 px-6 lg:px-32 max-w-6xl mx-auto w-full min-h-[70vh]">
        <div class="mb-8">
            <a href="/" class="inline-flex items-center justify-center text-dark-bg dark:text-white hover:text-brand-primary dark:hover:text-brand-secondary transition-colors p-2 -ml-2 rounded-full hover:bg-black/5 dark:hover:bg-white/5 leading-none">
                <i class='bx bx-arrow-back text-2xl lg:text-3xl leading-none'></i>
            </a>
        </div>
        <div class="flex items-center gap-4 mb-6">
            <div class="w-12 h-12 bg-brand-primary/10 text-brand-primary dark:bg-brand-secondary/10 dark:text-brand-secondary rounded-xl flex items-center justify-center text-2xl">
                <i class='bx bx-cloud'></i>
            </div>
            <h1 class="text-4xl lg:text-5xl font-bold text-dark-bg dark:text-white">Design de SaaS & Tableaux de bord</h1>
        </div>
        <p class="text-xl text-gray-500 dark:text-gray-400 max-w-3xl mb-12">
            Des interfaces métiers complexes rendues simples, intuitives et scalables.
        </p>
        
        <div class="bg-brand-surface dark:bg-brand-dark rounded-3xl p-8 lg:p-12 border border-brand-light/20 dark:border-[#281E5A]/50">
            <h2 class="text-2xl font-bold text-dark-bg dark:text-white mb-4">Contenu en construction</h2>
            <p class="text-gray-500 dark:text-gray-400 max-w-2xl">
                Cette page est actuellement en cours de préparation. Elle abordera la gestion de la donnée, la création de Design Systems solides et l'amélioration de l'ergonomie sur des outils métiers et B2B.
            </p>
            <div class="mt-8">
                <a href="/contact/" class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-brand-primary text-white font-semibold rounded-xl hover:bg-brand-primary/90 transition-colors">
                    Discutons de votre projet
                    <i class='bx bx-right-arrow-alt'></i>
                </a>
            </div>
        </div>
    </main>
</Layout>
