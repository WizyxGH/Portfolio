---
import Layout from '../../layouts/Layout.astro';
import HeroSection from '../../components/expertises/mobile/HeroSection.astro';
import PainPoints from '../../components/expertises/mobile/PainPoints.astro';
import Benefits from '../../components/expertises/mobile/Benefits.astro';
import Process from '../../components/expertises/mobile/Process.astro';
import FeaturedProjects from '../../components/expertises/mobile/FeaturedProjects.astro';
import Pricing from '../../components/expertises/mobile/Pricing.astro';
import FAQ from '../../components/expertises/mobile/FAQ.astro';
import CTA from '../../components/expertises/mobile/CTA.astro';

const breadcrumbSchema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
        {
            "@type": "ListItem",
            "position": 1,
            "name": "Accueil",
            "item": "https://wizyx.me/"
        },
        {
            "@type": "ListItem",
            "position": 2,
            "name": "Expertises",
            "item": "https://wizyx.me/"
        },
        {
            "@type": "ListItem",
            "position": 3,
            "name": "Applications Mobiles",
            "item": "https://wizyx.me/expertises/applications-mobiles/"
        }
    ]
};

const serviceSchema = {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Design d'Applications Mobiles (iOS & Android)",
    "serviceType": [
        "UI/UX Design Mobile",
        "Design iOS",
        "Design Android",
        "Design System Mobile",
        "Prototypage Figma"
    ],
    "description": "Conception d'applications mobiles sur-mesure iOS et Android. Interfaces fluides, ergonomie tactile Thumb-Zone, respect des standards Human Interface Guidelines et Material Design.",
    "provider": {
        "@type": "Person",
        "name": "Florian Gertner Kilian",
        "url": "https://wizyx.me/"
    },
    "areaServed": [
        "Nice",
        "Toulon",
        "Paris",
        "Monaco",
        "Cannes",
        "France"
    ]
};
---

<Layout 
    title="Design d'Applications Mobiles iOS & Android - Freelance UI/UX Designer" 
    description="Besoin de concevoir ou refondre votre application mobile ? Je crée des interfaces iOS et Android intuitives, orientées rétention et prêtes pour vos développeurs."
    body_class=""
>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)}></script>

    <main class="flex-1 flex flex-col">
        <HeroSection />
        <PainPoints />
        <Benefits />
        <Process />
        <FeaturedProjects />
        <Pricing />
        <FAQ />
        <CTA />
    </main>

    <script is:inline>
        document.addEventListener("DOMContentLoaded", () => {
            const cards = document.querySelectorAll(".animate-on-scroll");
            if (cards.length) {
                const observer = new IntersectionObserver((entries) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            entry.target.classList.add("show");
                            observer.unobserve(entry.target);
                        }
                    });
                }, { threshold: 0.1 });

                cards.forEach((card) => {
                    observer.observe(card);
                });
            }
        });
    </script>
</Layout>
