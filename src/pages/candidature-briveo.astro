              <dl class="cockpit-rows">
                <div><dt>Contrat</dt><dd>CDI ou freelance</dd></div>
                <div><dt>Candidat</dt><dd>Florian Gertner Kilian</dd></div>
                <div><dt>Statut</dt><dd class="dd-em">Disponible</dd></div>
              </dl>
              <div class="cockpit-bars">
                <span class="bar" style="--h:44%; --i:0"></span>
                <span class="bar" style="--h:68%; --i:1"></span>
                <span class="bar" style="--h:55%; --i:2"></span>
                <span class="bar" style="--h:82%; --i:3"></span>
                <span class="bar" style="--h:71%; --i:4"></span>
