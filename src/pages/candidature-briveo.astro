</head>

<body>
  <a href="#main" class="skip-link">Aller au contenu principal</a>

  <!-- Barre de progression, segmentée par chapitre. Chaque segment est une
       ancre cliquable à la souris. Elle double exactement la navigation :
       on la retire donc du parcours clavier et de l'arbre d'accessibilité
       plutôt que d'imposer 8 tabulations redondantes avant le contenu. -->
  <div class="scroll-rail" id="scrollRail" aria-hidden="true">
    {CHAPITRES.map((c, i) => (
      <a
        class="rail-seg"
        href={`#${c.id}`}
        data-chapter={i}
        data-target={c.id}
        data-label={`${String(i + 1).padStart(2, '0')} · ${c.label}`}
        tabindex="-1"
      ><span class="rail-fill"></span></a>
    ))}
  </div>

  <!-- ══════════════════════════ NAV ══════════════════════════ -->
  <header class="nav" id="nav">
    <div class="nav-inner">
      <a href="#top" class="nav-brand">
        <span class="nav-brand-mark">FGK</span>
        <span class="nav-brand-x">✕</span>
        <span class="nav-brand-co">BRIVEO</span>
      </a>
      <span class="nav-now" id="navNow">
        <span class="live-dot" aria-hidden="true"></span>
        <span class="mono-label" id="navNowLabel">01 · Intro</span>
      </span>
      <nav class="nav-links" aria-label="Sections de la page">
        <a href="#criteres">Vos critères</a>
        <a href="#audit">Mon audit</a>
        <a href="#plan">90 jours</a>
        <a href="#cv">Le CV</a>
        <a href="#profil">Qui je suis</a>
        <a href="#lettre">La lettre</a>
      </nav>
      <a href="#test" class="btn btn-sm btn-primary nav-cta">Me tester</a>
      <button class="burger" id="burger" type="button" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="mobileMenu">
        <span></span><span></span><span></span>
      </button>
    </div>

    <!-- Panneau mobile -->
    <div class="mobile-menu" id="mobileMenu" hidden>
      <nav aria-label="Sections de la page (mobile)">
        <a href="#criteres"><span class="mm-num">01</span> Vos critères</a>
        <a href="#audit"><span class="mm-num">02</span> Mon audit de briveo.fr</a>
        <a href="#plan"><span class="mm-num">03</span> Mes 90 premiers jours</a>
        <a href="#cv"><span class="mm-num">04</span> Le CV</a>
        <a href="#profil"><span class="mm-num">05</span> Qui je suis</a>
        <a href="#lettre"><span class="mm-num">06</span> La lettre</a>
      </nav>
      <div class="mobile-menu-foot">
        <a href="#test" class="btn btn-primary btn-block">Me tester</a>
        <a href={CV_PDF} target="_blank" rel="noopener" class="mm-cv">
          <svg viewBox="0 0 24 24" class="ico ico-em" aria-hidden="true"><path d="M14 3H7a2 2 0 00-2 2v14a2 2 0 002 2h10a2 2 0 002-2V8z"/><path d="M14 3v5h5"/><path d="M12 11v6M9.5 14.5L12 17l2.5-2.5"/></svg>
          CV en PDF
        </a>
      </div>
    </div>
  </header>

  <main id="main">
    <span id="top" tabindex="-1"></span>
    <!-- ══════════════════════════ HERO ══════════════════════════ -->
    <section class="hero">
      <div class="grain" aria-hidden="true"></div>
      <div class="mesh mesh-a" aria-hidden="true"></div>
      <div class="mesh mesh-b" aria-hidden="true"></div>

      <div class="hero-inner">
        <div class="hero-copy">
          <span class="pill reveal">
            <span class="live-dot" aria-hidden="true"></span>
            <span class="mono-label">Candidature · {OFFRE.intitule} · {OFFRE.lieu}</span>
          </span>

          <h1 class="hero-title reveal" style="--d:60ms">
            <span class="line-muted">Postuler</span>
            <span class="line-muted">sans CV.</span>
            <span class="line-ink">Recruter</span>
            <span class="line-ink">sans risque.</span>
          </h1>

          <p class="hero-sub reveal" style="--d:120ms">
            Vous cherchez un designer produit à Nice&nbsp;: <strong>3 ans d'expérience</strong>,
            une <strong>sensibilité au luxe et à la précision</strong>, la{' '}
            <strong>capacité à parler directement aux utilisateurs</strong>. J'ai lu votre annonce.
            Plutôt que de vous envoyer un PDF de plus, j'ai conçu et développé cette page{' '}
            <strong>dans votre design system</strong>.
