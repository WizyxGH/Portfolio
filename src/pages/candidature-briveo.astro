  { valeur: 25, suffixe: '', label: 'Projets publiés et consultables' },
  { valeur: 100, suffixe: '%', label: 'Clients satisfaits' },
  { valeur: 3, suffixe: '', label: 'Langues de travail — FR · EN · DE' },
];

const AUDIT = [
