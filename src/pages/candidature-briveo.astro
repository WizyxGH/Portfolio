const OBJECTIONS = [
  {
    q: 'Vous êtes jeune.',
    r: "Oui. Et j'ai trois ans de pratique, vingt-cinq projets publics et des clients qui acceptent de mettre leur nom sous un témoignage. Le portfolio est en ligne, ouvert, daté. Jugez le travail avant la date de naissance — c'est le seul avantage du métier de designer, tout est vérifiable.",
