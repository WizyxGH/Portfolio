const PLAN = [
  {
    num: '01',
    duree: 'Semaines 1 à 2',
    titre: 'Écouter',
    texte:
      "Dix entretiens : des vendeurs Smart, des vendeurs Premium, deux agents carte T, un notaire partenaire, et surtout des gens qui ont abandonné le tunnel. Objectif : la carte des frictions réelles, pas supposées. Je repars avec une liste priorisée que toute l'équipe peut lire.",
