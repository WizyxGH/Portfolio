// ─────────────────────────────────────────────────────────────────────────────
//  /candidature-briveo — page isolée, non reliée au reste de wizyx.me.
//
//  Elle n'utilise NI Layout.astro, NI global.css, NI Tailwind, NI boxicons :
//  tout est autonome (son propre <html>, ses propres polices, son propre CSS).
//  Objectif : reprendre le design system de briveo.fr sans qu'une seule règle
//  ne puisse fuir vers les autres pages du portfolio.
//
//  Le design system reproduit ici vient de briveo.fr :
//    · fond #FAFAF9, encre neutral-950, accent emerald-500 → 700
//    · Plus Jakarta Sans (titres/corps) + JetBrains Mono (chiffres & micro-labels)
//    · micro-labels mono, uppercase, tracking 0.2em
//    · animations maison : live-dot, float, reveal, shimmer, mesh-drift,
//      bar-grow, caret, marquee, grain SVG, barre de progression de scroll
// ─────────────────────────────────────────────────────────────────────────────
import { Font, Image } from 'astro:assets';
import avatarFlorian from '../assets/media/profilepicturepro.webp';
import avatarCaroline from '../assets/media/photo/carolineaubert.webp';
import avatarJonathan from '../assets/media/photo/jonathanvaissiere.webp';
import avatarLucas from '../assets/media/photo/lucaskacem.webp';

// ⚠️ Dépose le PDF dans `public/assets/` sous ce nom (ou change la valeur ici).
// C'est le seul endroit à modifier : le lien est réutilisé à trois endroits.
const CV_PDF = '/assets/cv-florian-gertner-kilian.pdf';

// Les aperçus de partage exigent des URL absolues : un chemin relatif
// laisse LinkedIn et WhatsApp sans image.
const SITE = 'https://wizyx.me';
const ogUrl = `${SITE}/candidature-briveo`;
const ogImage = `${SITE}/assets/media/opengraph/candidature-briveo-og.png`;

// Format international : les recruteurs enregistrent le numéro tel quel, et
// le lien tel: doit rester sans espaces pour être composable partout.
const TEL_DISPLAY = '+33 7 78 40 78 87';
const TEL_HREF = '+33778407887';

// Chapitrage de la barre de progression. L'ordre doit suivre l'ordre réel des
// sections dans le DOM : les largeurs sont ensuite calculées depuis les
// positions mesurées, donc un segment = la hauteur de scroll réelle du bloc.
const CHAPITRES = [
  { id: 'top', label: 'Intro' },
  { id: 'criteres', label: 'Vos critères' },
  { id: 'audit', label: 'Mon audit' },
  { id: 'plan', label: '90 jours' },
  { id: 'cv', label: 'Le CV' },
  { id: 'profil', label: 'Qui je suis' },
  { id: 'lettre', label: 'La lettre' },
  { id: 'test', label: 'Me tester' },
];

const OFFRE = {
  intitule: 'Produit — Design',
  lieu: 'Nice (HQ) / Remote-friendly',
  contrat: 'CDI ou freelance',
  criteres: [
    'Expérience product/design 3 ans+',
    'Sensibilité au luxe + à la précision',
    'Capacité à interagir directement avec utilisateurs',
  ],
};

