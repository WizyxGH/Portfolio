  <!-- ═══════════════════════════════════════════════════════════════════════
       STYLES — 100 % locaux à cette page (aucun import de global.css)
       ═══════════════════════════════════════════════════════════════════════ -->
  <style is:global>
    /* ── Tokens repris de briveo.fr ─────────────────────────────────────── */
    :root {
      --ink: #0a0a0a;
      --ink-700: #404040;
      --ink-600: #525252;
      --ink-500: #737373;
      --ink-400: #a3a3a3;
      --paper: #fafaf9;
      --paper-2: #f5f5f4;
      --white: #ffffff;

      --em-50: #ecfdf5;
      --em-100: #d1fae5;
      --em-200: #a7f3d0;
      --em-300: #6ee7b7;
      --em-400: #34d399;
      --em-500: #10b981;
      --em-600: #059669;
      --em-700: #047857;
      --em-800: #065f46;
      --em-900: #064e3b;
      --em-950: #022c22;
      --amber-200: #fde68a;

      --line: rgba(23, 23, 23, 0.1);
      --line-strong: rgba(23, 23, 23, 0.16);
      --line-light: rgba(255, 255, 255, 0.12);

      --r-sm: 0.75rem;
      --r-md: 1rem;
      --r-lg: 1.5rem;
      --r-xl: 1.5rem;

      --sans: var(--font-jakarta-family), "Plus Jakarta Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
      --mono: var(--font-jetbrains-family), "JetBrains Mono", ui-monospace, Menlo, Consolas, monospace;

      --shadow-cta: 0 14px 44px -12px rgba(4, 120, 87, 0.6);
      --shadow-cta-hi: 0 20px 54px -12px rgba(4, 120, 87, 0.72);
      --shadow-card: 0 1px 2px rgba(10, 10, 10, 0.04);
      --shadow-float: 0 22px 60px -22px rgba(10, 10, 10, 0.32);

      --maxw: 1200px;
    }

    *, *::before, *::after { box-sizing: border-box; }

    html {
      scroll-behavior: smooth;
      scroll-padding-top: 96px;
      -webkit-text-size-adjust: 100%;
    }

    body {
      margin: 0;
      background: var(--paper);
      color: var(--ink);
      font-family: var(--sans);
      font-size: 17px;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
      overflow-x: hidden;
    }

    h1, h2, h3, h4 { margin: 0; letter-spacing: -0.03em; line-height: 1.05; }
    p { margin: 0; }
    ul, ol { margin: 0; padding: 0; list-style: none; }
    a { color: inherit; text-decoration: none; }
    strong { font-weight: 700; color: var(--ink); }

    ::selection { background: var(--em-600); color: #fff; }

    /* ── Primitives ─────────────────────────────────────────────────────── */
    .wrap { width: 100%; max-width: var(--maxw); margin: 0 auto; padding: 0 20px; position: relative; z-index: 2; }
    .wrap-narrow { max-width: 780px; }
    @media (min-width: 768px) { .wrap { padding: 0 40px; } }

    .mono-label {
      font-family: var(--mono);
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.2em;
      font-weight: 500;
      color: var(--ink-700);
      display: inline-flex;
      align-items: center;
      gap: 6px;
      line-height: 1.4;
    }
    .mono-label-em { color: var(--em-700); }
    .mono-label-mint { color: var(--em-300); }
    .mono-label-light { color: rgba(255, 255, 255, 0.9); }
    .mono-label-dim { color: var(--ink-500); }

    .eyebrow {
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.2em;
      color: var(--em-700);
      display: block;
    }
    .eyebrow-light { color: var(--em-400); }

    .pill {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      border: 1px solid var(--line);
      background: var(--white);
      border-radius: 999px;
      padding: 7px 15px;
      box-shadow: var(--shadow-card);
    }
    .pill-dark { background: rgba(255, 255, 255, 0.06); border-color: var(--line-light); box-shadow: none; }

    .live-dot {
      position: relative;
      width: 8px; height: 8px;
      border-radius: 999px;
      background: var(--em-500);
      flex: none;
      animation: live-pulse 1.8s ease-out infinite;
    }
    .live-dot-sm { width: 6px; height: 6px; background: var(--em-400); }

    .ico { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; flex: none; }
    .ico-xs { width: 12px; height: 12px; }
    .ico-em { color: var(--em-700); width: 15px; height: 15px; }
    .ico-arrow { width: 18px; height: 18px; transition: transform 0.25s ease; }

    /* ── Boutons ────────────────────────────────────────────────────────── */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      border-radius: 999px;
      font-weight: 700;
      font-size: 15px;
      letter-spacing: -0.01em;
      cursor: pointer;
      border: 1px solid transparent;
      transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.25s ease,
        background 0.25s ease, border-color 0.25s ease, color 0.25s ease;
      padding: 14px 26px;
      white-space: nowrap;
    }
    .btn-lg { padding: 18px 32px; font-size: 16px; }
    .btn-sm { padding: 9px 18px; font-size: 13px; }
    .btn-block { width: 100%; margin-top: auto; }

    .btn-primary {
      background: linear-gradient(to bottom, var(--em-500), var(--em-700));
      color: #fff;
      box-shadow: var(--shadow-cta);
      box-shadow: var(--shadow-cta), inset 0 0 0 1px rgba(255, 255, 255, 0.2);
    }
    .btn-primary:hover {
      transform: translateY(-2px);
      background: linear-gradient(to bottom, var(--em-500), var(--em-800));
      box-shadow: var(--shadow-cta-hi), inset 0 0 0 1px rgba(255, 255, 255, 0.24);
    }
    .btn-primary:hover .ico-arrow { transform: translateX(4px); }

    .btn-ghost { border-color: var(--line-strong); color: var(--ink); background: transparent; }
    .btn-ghost:hover { background: var(--white); border-color: rgba(23, 23, 23, 0.38); transform: translateY(-2px); }

    .btn-ghost-light { border-color: rgba(255, 255, 255, 0.24); color: #fff; background: transparent; }
    .btn-ghost-light:hover { background: rgba(255, 255, 255, 0.08); border-color: rgba(255, 255, 255, 0.45); transform: translateY(-2px); }

    .btn-outline { border-color: var(--line-strong); color: var(--ink); background: var(--white); }
    .btn-outline:hover { border-color: var(--em-600); color: var(--em-700); transform: translateY(-2px); }

    /* ── Scrollbar personnalisée (valeurs relevées sur briveo.fr) ───────── */
    ::-webkit-scrollbar { width: 10px; height: 10px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb {
      background: rgba(5, 150, 105, 0.25);
      border-radius: 5px;
      border: 2px solid transparent;
      background-clip: content-box;
    }
    ::-webkit-scrollbar-thumb:hover { background: rgba(5, 150, 105, 0.5); background-clip: content-box; }
    html { scrollbar-width: thin; scrollbar-color: rgba(5, 150, 105, 0.35) transparent; }

    /* ── Barre de progression chapitrée ─────────────────────────────────
       Un segment par section, largeur proportionnelle à sa hauteur de
       scroll réelle (posée en JS). Au survol la barre s'épaissit et
       affiche le nom du chapitre : elle devient un moyen de navigation.  */
    .scroll-rail {
      position: fixed;
      inset: 0 0 auto 0;
      height: 3px;
      z-index: 95;
      display: flex;
      gap: 2px;
      transition: height 0.25s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .scroll-rail:hover, .scroll-rail.is-touched { height: 7px; }
    .rail-seg {
      position: relative;
      flex: 1 1 0;
      min-width: 4px;
      background: rgba(23, 23, 23, 0.09);
      overflow: visible;
    }
    .rail-seg::before {
      content: "";
      position: absolute;
      inset: 0;
      background: inherit;
    }
    .rail-fill {
      position: absolute;
      inset: 0;
      transform: scaleX(0);
      transform-origin: left center;
      background: linear-gradient(to right, var(--em-600), var(--em-400));
      transition: transform 0.12s linear;
      z-index: 1;
    }
    .rail-seg.is-done .rail-fill { transform: scaleX(1); }
    /* Étiquette du chapitre au survol du segment */
    .rail-seg::after {
      content: attr(data-label);
      position: absolute;
      top: calc(100% + 8px);
      left: 50%;
      transform: translateX(-50%) translateY(-4px);
      white-space: nowrap;
      font-family: var(--mono);
      font-size: 9.5px;
      text-transform: uppercase;
      letter-spacing: 0.16em;
      color: #fff;
      background: var(--em-700);
      border-radius: 999px;
      padding: 5px 10px;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s ease, transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
      box-shadow: 0 10px 24px -10px rgba(4, 120, 87, 0.7);
      z-index: 2;
    }
    .rail-seg:hover::after { opacity: 1; transform: translateX(-50%) translateY(0); }
    /* Les segments des extrémités décalent leur étiquette pour ne pas sortir. */
    .rail-seg:first-child::after { left: 8px; transform: translateX(0) translateY(-4px); }
    .rail-seg:first-child:hover::after { transform: translateX(0) translateY(0); }
    .rail-seg:last-child::after { left: auto; right: 8px; transform: translateX(0) translateY(-4px); }
    .rail-seg:last-child:hover::after { transform: translateX(0) translateY(0); }

    /* ── Chapitre courant affiché dans la nav ───────────────────────────── */
    .nav-now {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 5px 11px 5px 9px;
      border: 1px solid var(--line);
      border-radius: 999px;
      background: var(--white);
      max-width: 46vw;
      overflow: hidden;
    }
    .nav-now .mono-label { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: block; }
    @media (min-width: 940px) { .nav-now { display: none; } }
    @media (max-width: 359px) { .nav-now { display: none; } }

    /* ── Nav ────────────────────────────────────────────────────────────── */
    .nav {
      position: sticky;
      top: 0;
      z-index: 80;
      background: rgba(250, 250, 249, 0.72);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border-bottom: 1px solid transparent;
      transition: border-color 0.3s ease, background 0.3s ease;
    }
    .nav.is-stuck { border-bottom-color: var(--line); background: rgba(250, 250, 249, 0.9); }
    .nav-inner {
      max-width: var(--maxw);
      margin: 0 auto;
      padding: 0 20px;
      height: 64px;
      display: flex;
      align-items: center;
      gap: 24px;
    }
    @media (min-width: 768px) { .nav-inner { padding: 0 40px; height: 68px; } }
    .nav-brand { display: inline-flex; align-items: center; gap: 9px; font-family: var(--mono); font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; }
    .nav-brand-mark { font-weight: 700; color: var(--ink); }
    .nav-brand-x { color: var(--em-600); }
    .nav-brand-co { font-weight: 700; color: var(--em-700); }
    .nav-links { display: none; gap: 26px; margin-left: auto; }
    .nav-links a {
      font-size: 14px;
      font-weight: 600;
      color: var(--ink-600);
      position: relative;
      padding: 4px 0;
      transition: color 0.2s ease;
    }
    .nav-links a::after {
      content: "";
      position: absolute;
      left: 0; bottom: 0;
      height: 1.5px; width: 0;
      background: var(--em-600);
      transition: width 0.28s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .nav-links a:hover { color: var(--ink); }
    .nav-links a:hover::after { width: 100%; }
    .nav-links a.is-current { color: var(--em-700); }
    .nav-links a.is-current::after { width: 100%; background: var(--em-600); }
    .mobile-menu nav a.is-current { color: var(--em-700); }
    .mobile-menu nav a.is-current .mm-num { color: var(--ink-400); }
    .nav-cta { margin-left: auto; }
    @media (min-width: 940px) {
      .nav-links { display: flex; }
      .nav-cta { margin-left: 0; }
    }
    @media (max-width: 479px) { .nav-cta { display: none; } }

    /* ── Burger + panneau mobile ────────────────────────────────────────── */
    .burger {
      margin-left: 12px;
      width: 42px; height: 42px;
      flex: none;
      display: inline-flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 5px;
      border: 1px solid var(--line-strong);
      border-radius: 12px;
      background: var(--white);
      cursor: pointer;
      transition: border-color 0.25s ease, background 0.25s ease;
    }
    @media (max-width: 479px) { .burger { margin-left: auto; } }
    .burger:hover { border-color: rgba(23, 23, 23, 0.36); }
    .burger span {
      display: block;
      width: 17px; height: 1.8px;
      border-radius: 2px;
      background: var(--ink);
      transition: transform 0.32s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.2s ease, width 0.32s ease;
    }
    .burger.is-open span:nth-child(1) { transform: translateY(6.8px) rotate(45deg); }
    .burger.is-open span:nth-child(2) { opacity: 0; transform: scaleX(0); }
    .burger.is-open span:nth-child(3) { transform: translateY(-6.8px) rotate(-45deg); }
    @media (min-width: 940px) { .burger { display: none; } }

    .mobile-menu {
      border-top: 1px solid var(--line);
      background: rgba(250, 250, 249, 0.97);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      padding: 12px 20px 20px;
      max-height: calc(100dvh - 64px);
      overflow-y: auto;
      animation: menu-in 0.28s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    .mobile-menu[hidden] { display: none; }
    @media (min-width: 940px) { .mobile-menu { display: none !important; } }
    .mobile-menu nav { display: grid; }
    .mobile-menu nav a {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 15px 4px;
      font-size: 16px;
      font-weight: 700;
      letter-spacing: -0.02em;
      border-bottom: 1px solid var(--line);
      transition: color 0.2s ease, padding-left 0.25s ease;
    }
    .mobile-menu nav a:hover, .mobile-menu nav a:active { color: var(--em-700); padding-left: 10px; }
    .mm-num { font-family: var(--mono); font-size: 11px; letter-spacing: 0.14em; color: var(--em-600); font-weight: 500; }
    .mobile-menu-foot { margin-top: 18px; display: grid; gap: 12px; justify-items: center; }
    .mm-cv {
      display: inline-flex; align-items: center; gap: 8px;
      font-family: var(--mono);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.16em;
      color: var(--ink-600);
      padding: 8px;
    }
    .mm-cv .ico { width: 14px; height: 14px; }

    /* Chiffres dans les titres : traitement mono/tabulaire, comme briveo.fr */
    .num {
      font-family: var(--mono);
      font-weight: 700;
      font-size: 0.9em;
      letter-spacing: -0.04em;
      font-variant-numeric: tabular-nums;
    }

    /* ── Décors : grain, mesh, glow ─────────────────────────────────────── */
    .grain {
      position: absolute;
      inset: 0;
      pointer-events: none;
      opacity: 0.06;
      mix-blend-mode: overlay;
      background-image: url("data:image/svg+xml;utf8,<svg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3' stitchTiles='stitch'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
    }
    .mesh {
      position: absolute;
      pointer-events: none;
      border-radius: 999px;
      filter: blur(80px);
      animation: mesh-drift 22s ease-in-out infinite;
    }
    .mesh-a {
      right: -180px; top: -180px;
      width: 620px; height: 620px;
      background: radial-gradient(circle at 30% 30%, rgba(253, 230, 138, 0.45), rgba(110, 231, 183, 0.22) 45%, transparent 72%);
    }
    .mesh-b {
      left: -260px; bottom: -220px;
      width: 560px; height: 560px;
      background: radial-gradient(circle at 60% 40%, rgba(16, 185, 129, 0.16), transparent 70%);
      animation-delay: -8s;
    }
    .mesh-dark {
      right: -160px; top: 10%;
      width: 620px; height: 620px;
      background: radial-gradient(circle at 40% 40%, rgba(16, 185, 129, 0.22), transparent 70%);
    }
    .glow { position: absolute; pointer-events: none; border-radius: 999px; filter: blur(90px); }
    .glow-a { left: 12%; top: 60px; width: 420px; height: 420px; background: rgba(16, 185, 129, 0.07); }
    .glow-b { right: 6%; top: 120px; width: 380px; height: 380px; background: rgba(253, 230, 138, 0.22); }
    .glow-c { left: 50%; top: 40px; width: 520px; height: 340px; transform: translateX(-50%); background: rgba(16, 185, 129, 0.08); }

    /* ── Hero ───────────────────────────────────────────────────────────── */
    .hero { position: relative; overflow: hidden; background: var(--paper); }
    .hero-inner {
      position: relative;
      z-index: 2;
      max-width: 1340px;
      margin: 0 auto;
      padding: 80px 20px 40px;
      display: grid;
      gap: 48px;
      align-items: center;
    }
    @media (min-width: 768px) { .hero-inner { padding: 96px 40px 96px; gap: 64px; } }
    @media (min-width: 1060px) {
      .hero-inner { grid-template-columns: 1.2fr 0.85fr; gap: 80px; padding: 112px 40px 112px; }
    }

    /* Échelle typo par palier, comme sur briveo.fr : on plafonne bas sur
       mobile pour éviter les mots coupés, puis on ouvre franchement au-delà. */
    .hero-title {
      margin-top: 22px;
      font-size: clamp(2.3rem, 10.4vw, 2.9rem);
      font-weight: 800;
      line-height: 0.95;
      letter-spacing: -0.04em;
      display: flex;
      flex-direction: column;
      overflow-wrap: break-word;
    }
    .hero-title .line-muted { color: var(--ink-500); }
    .hero-title .line-ink { color: var(--ink); }
    @media (min-width: 640px) { .hero-title { margin-top: 26px; font-size: clamp(3.3rem, 8.6vw, 5.2rem); line-height: 0.93; letter-spacing: -0.045em; } }
    @media (min-width: 1060px) { .hero-title { font-size: clamp(4.4rem, 6.8vw, 7.4rem); } }

    .hero-sub {
      margin-top: 22px;
      max-width: 620px;
      font-size: 16.5px;
      line-height: 1.6;
      color: var(--ink-600);
    }
    @media (min-width: 640px) { .hero-sub { font-size: 18px; margin-top: 28px; } }
    @media (min-width: 1060px) { .hero-sub { font-size: 19.5px; margin-top: 34px; } }

    .hero-cta { margin-top: 28px; display: flex; flex-wrap: wrap; gap: 10px; }
    /* Sur les très petits écrans les CTA passent pleine largeur (Briveo fait
       de même : flex-col puis sm:flex-row). */
    @media (max-width: 419px) { .hero-cta { flex-direction: column; align-items: stretch; } .hero-cta .btn { width: 100%; } }
    @media (min-width: 640px) { .hero-cta { margin-top: 32px; gap: 12px; } }
    .hero-trust {
      margin-top: 30px;
      padding-top: 20px;
      border-top: 1px solid var(--line);
      display: flex;
      flex-wrap: wrap;
      gap: 10px 20px;
      font-size: 12.5px;
      color: var(--ink-600);
      font-weight: 500;
    }
    .hero-trust li { display: inline-flex; align-items: center; gap: 8px; }
    @media (min-width: 640px) { .hero-trust { margin-top: 34px; padding-top: 22px; gap: 10px 26px; } }

    .hero-scroll {
      position: relative;
      z-index: 2;
      max-width: 1340px;
      margin: 0 auto;
      padding: 14px 20px 22px;
      border-top: 1px solid var(--line);
    }
    @media (min-width: 768px) { .hero-scroll { padding: 16px 40px 26px; } }

    /* ── Pile de cartes du hero ─────────────────────────────────────────
       Sous 1060px la superposition absolue devient illisible : les cartes
       repassent en flux dans une grille 2 colonnes, sans se recouvrir.
       Au-delà, on retrouve la composition flottante de briveo.fr.         */
    .hero-visual {
      position: relative;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
      align-content: start;
    }
    @media (min-width: 1060px) {
      .hero-visual { display: block; min-height: 560px; }
    }

    .cockpit {
      position: relative;
      border-radius: var(--r-xl);
      overflow: hidden;
      background: linear-gradient(160deg, #043b2b 0%, #022c22 55%, #04150f 100%);
      color: #fff;
      box-shadow: var(--shadow-float);
      padding: 0;
      margin: 0 auto;
      width: 100%;
      max-width: 460px;
      grid-column: 1 / -1;
    }
    .cockpit::after {
      content: "";
      position: absolute;
      inset: 0;
      background: radial-gradient(120% 80% at 80% 0%, rgba(16, 185, 129, 0.28), transparent 60%);
      pointer-events: none;
    }
    .cockpit-top {
      display: flex; align-items: center; gap: 9px;
      padding: 14px 20px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.09);
      background: rgba(255, 255, 255, 0.03);
      position: relative; z-index: 2;
    }
    .cockpit-body { padding: 26px 24px 24px; position: relative; z-index: 2; }
    .cockpit-title { font-size: 27px; font-weight: 800; letter-spacing: -0.035em; line-height: 1.1; margin-top: 12px; }
    .cockpit-rows { margin: 22px 0 0; display: grid; gap: 1px; background: rgba(255, 255, 255, 0.09); border-radius: var(--r-sm); overflow: hidden; }
    .cockpit-rows > div { display: flex; justify-content: space-between; gap: 16px; padding: 11px 14px; background: rgba(255, 255, 255, 0.04); }
    .cockpit-rows dt { font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.16em; color: rgba(255, 255, 255, 0.55); }
    .cockpit-rows dd { margin: 0; font-size: 13px; font-weight: 600; text-align: right; }
    .cockpit-rows .dd-em { color: var(--em-300); }
    .cockpit-bars { margin-top: 24px; height: 74px; display: flex; align-items: flex-end; gap: 8px; }
    .cockpit-bars .bar {
      flex: 1;
      height: var(--h);
      border-radius: 4px 4px 2px 2px;
      background: rgba(110, 231, 183, 0.28);
      transform-origin: bottom;
      animation: bar-grow 0.75s cubic-bezier(0.22, 1, 0.36, 1) both;
      animation-delay: calc(var(--i) * 90ms + 300ms);
    }
    .cockpit-bars .bar-hi { background: linear-gradient(to top, var(--em-500), var(--em-300)); }
    .cockpit-foot { margin-top: 12px; font-family: var(--mono); font-size: 9.5px; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(255, 255, 255, 0.62); }

    .float-card {
      position: relative;
      background: var(--white);
      border-radius: var(--r-lg);
      padding: 16px 17px;
      box-shadow: 0 20px 50px -20px rgba(10, 10, 10, 0.28);
      border: 1px solid rgba(23, 23, 23, 0.06);
      z-index: 3;
      min-width: 0;
    }
    .float-c { grid-column: 1 / -1; }
    @media (min-width: 1060px) {
      .float-card { position: absolute; padding: 17px 18px; animation: float 6s ease-in-out infinite; }
      .float-a { width: 232px; left: -70px; top: 48px; }
      .float-b { width: 210px; right: -34px; bottom: 130px; animation-delay: -2s; }
      .float-c { width: 250px; left: -46px; bottom: 6px; animation-delay: -4s; }
    }

    .float-num { font-family: var(--mono); font-size: 28px; font-weight: 800; letter-spacing: -0.04em; margin-top: 10px; font-variant-numeric: tabular-nums; }
    @media (min-width: 480px) { .float-num { font-size: 30px; } }
    .float-cap { font-size: 11px; color: var(--ink-500); margin-top: 2px; line-height: 1.35; }
    .float-track { margin-top: 11px; height: 5px; border-radius: 999px; background: var(--em-100); overflow: hidden; }
    .float-fill { display: block; height: 100%; width: 94%; border-radius: 999px; background: linear-gradient(to right, var(--em-600), var(--em-400)); background-size: 200% auto; animation: shimmer 4s linear infinite; }
    .float-note { margin-top: 9px; font-size: 10px; color: var(--ink-500); }

    .float-dark { background: var(--em-700); border-color: rgba(255, 255, 255, 0.12); color: #fff; }
    .float-chip { display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 9px; background: rgba(16, 185, 129, 0.22); border: 1px solid rgba(52, 211, 153, 0.4); color: var(--em-300); margin-bottom: 11px; }
    .float-dark-title { font-size: 15px; font-weight: 800; margin-top: 9px; letter-spacing: -0.02em; }
    .float-dark-sub { font-size: 10.5px; color: var(--em-200); margin-top: 3px; }

    .float-typed { margin-top: 10px; font-size: 12.5px; line-height: 1.5; color: var(--ink-700); min-height: 3.1em; }
    @media (min-width: 1060px) { .float-typed { min-height: 57px; } }
    .caret { display: inline-block; width: 2px; height: 1em; background: var(--em-600); vertical-align: -2px; margin-left: 2px; animation: caret 0.85s steps(1) infinite; }

    /* ── Bandeau chiffres ───────────────────────────────────────────────── */
    .stats { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); background: var(--white); }
    .stats-inner {
      max-width: var(--maxw);
      margin: 0 auto;
      padding: 44px 20px;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 40px 20px;
    }
    @media (min-width: 768px) { .stats-inner { padding: 56px 40px; } }
    @media (min-width: 820px) { .stats-inner { grid-template-columns: repeat(4, minmax(0, 1fr)); padding: 56px 40px; } }
    /* Chiffres : mono + tabulaire + graisse maximale, comme le bandeau de
       briveo.fr. L'unité est un élément distinct, plus petite et atténuée. */
    .stat-num {
      font-family: var(--mono);
      font-size: clamp(28px, 6.4vw, 48px);
      font-weight: 700;
      letter-spacing: -0.045em;
      font-variant-numeric: tabular-nums;
      line-height: 1;
      display: flex;
      align-items: baseline;
      gap: 2px;
    }
    .stat-unit { font-size: 0.62em; color: var(--ink-500); font-weight: 500; }
    .stat-label { margin-top: 10px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.09em; color: var(--ink-500); line-height: 1.45; }

    /* ── Marquee ────────────────────────────────────────────────────────── */
    .marquee-wrap { background: var(--paper); padding: 22px 0; overflow: hidden; border-bottom: 1px solid var(--line); }
    .marquee { position: relative; }
    .marquee::before, .marquee::after {
      content: ""; position: absolute; top: 0; bottom: 0; width: 100px; z-index: 2; pointer-events: none;
    }
    .marquee::before { left: 0; background: linear-gradient(to right, var(--paper), transparent); }
    .marquee::after { right: 0; background: linear-gradient(to left, var(--paper), transparent); }
    @media (max-width: 699px) { .marquee::before, .marquee::after { width: 48px; } }
    .marquee-track { display: flex; width: max-content; animation: marquee 42s linear infinite; }
    .marquee-group { display: flex; align-items: center; gap: 22px; padding-right: 22px; }
    .marquee-group span { font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.2em; color: var(--ink-500); white-space: nowrap; }
    .marquee-group em { color: var(--em-500); font-style: normal; }

    /* ── Sections ───────────────────────────────────────────────────────── */
    .section { position: relative; padding: 88px 0; overflow: hidden; }
    @media (min-width: 640px) { .section { padding: 112px 0; } }
    @media (min-width: 900px) { .section { padding: 144px 0; } }
    .section-soft { background: var(--paper-2); }
    .section-dark { background: #071b14; color: #fff; }

    .sec-head { max-width: 660px; margin: 0 auto 40px; text-align: center; }
    @media (min-width: 640px) { .sec-head { margin-bottom: 54px; } }
    .sec-head-left { margin-left: 0; text-align: left; }
    .sec-title {
      margin-top: 16px;
      font-size: clamp(1.9rem, 7.4vw, 3.7rem);
      font-weight: 800;
      letter-spacing: -0.035em;
      line-height: 1.06;
      overflow-wrap: break-word;
    }
    @media (min-width: 640px) { .sec-title { margin-top: 16px; letter-spacing: -0.04em; line-height: 1.03; } }
    .sec-title-light { color: #fff; }
    .sec-sub { margin-top: 24px; font-size: 16px; line-height: 1.62; color: var(--ink-600); }
    @media (min-width: 640px) { .sec-sub { font-size: 17px; } }
    .sec-sub-light { color: rgba(255, 255, 255, 0.66); }

    .card {
      background: var(--white);
      border: 1px solid var(--line);
      border-radius: var(--r-lg);
      box-shadow: var(--shadow-card);
      padding: 24px;
    }
    @media (min-width: 640px) { .card { border-radius: var(--r-xl); padding: 32px; } }
    @media (min-width: 900px) { .card { padding: 40px; } }

    /* ── Critères ───────────────────────────────────────────────────────── */
    .crit-grid { display: grid; gap: 20px; }
    @media (min-width: 640px) { .crit-grid { gap: 24px; } }
    @media (min-width: 900px) { .crit-grid { grid-template-columns: repeat(2, 1fr); } }

    .crit { display: flex; flex-direction: column; transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.4s ease, border-color 0.4s ease; }
    .crit:hover { transform: translateY(-4px); box-shadow: 0 26px 60px -30px rgba(10, 10, 10, 0.28); border-color: rgba(5, 150, 105, 0.28); }
    /* Sous 520px, le numéro et la citation de l'annonce s'empilent plutôt
       que de se disputer 300px de large. */
    .crit-head { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; }
    @media (min-width: 520px) { .crit-head { flex-direction: row; justify-content: space-between; gap: 14px; } }
    .crit-num { font-family: var(--mono); font-size: 30px; font-weight: 700; letter-spacing: -0.05em; color: var(--ink-500); line-height: 1; }
    @media (min-width: 640px) { .crit-num { font-size: 34px; } }
    .crit-num-em { color: var(--em-600); }
    .quote-chip {
      border: 1px solid var(--line);
      background: var(--paper-2);
      border-radius: 999px;
      padding: 6px 13px;
      font-size: 11px;
      font-weight: 600;
      color: var(--ink-600);
      text-align: left;
      line-height: 1.35;
      max-width: 100%;
    }
    @media (min-width: 520px) { .quote-chip { text-align: right; max-width: 62%; } }
    .quote-chip-em { background: var(--em-50); border-color: var(--em-200); color: var(--em-800); }
    .crit-title { margin-top: 22px; font-size: 23px; font-weight: 800; line-height: 1.18; letter-spacing: -0.03em; }
    @media (min-width: 700px) { .crit-title { font-size: 25px; } }
    .crit-body { margin-top: 16px; font-size: 15.5px; line-height: 1.68; color: var(--ink-600); }
    .crit-body + .crit-body { margin-top: 13px; }

    .crit-proof { margin-top: auto; padding-top: 22px; display: grid; gap: 10px; }
    .crit-proof li { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; font-size: 14px; }
    .crit-proof a { color: var(--em-700); font-weight: 600; border-bottom: 1px solid rgba(4, 120, 87, 0.28); transition: border-color 0.2s ease; }
    .crit-proof a:hover { border-bottom-color: var(--em-700); }

    .testi { margin: 22px 0 0; padding: 18px 20px; background: var(--paper-2); border-left: 3px solid var(--em-500); border-radius: 0 var(--r-sm) var(--r-sm) 0; }
    .testi p { font-size: 14px; line-height: 1.62; color: var(--ink-700); font-style: italic; }
    .testi footer { margin-top: 14px; display: flex; align-items: center; gap: 11px; font-style: normal; }
    .testi footer span { display: grid; gap: 1px; font-size: 11.5px; color: var(--ink-500); line-height: 1.4; }
    .testi footer strong { font-size: 13px; color: var(--ink); font-weight: 700; }
    .testi-av {
      width: 36px; height: 36px;
      flex: none;
      border-radius: 999px;
      object-fit: cover;
      background: var(--paper);
      box-shadow: 0 0 0 2px var(--white), 0 0 0 3px var(--em-200);
    }

    .crit-callback {
      margin-top: 14px;
      font-size: 13.5px;
      line-height: 1.55;
      color: var(--ink-600);
      font-style: italic;
    }
    .crit-callback .mono-label { font-style: normal; margin-right: 2px; }

    .crit-bonus { border-color: rgba(5, 150, 105, 0.3); background: linear-gradient(180deg, #fff 0%, #f4fdf9 100%); }

    /* ── Audit ──────────────────────────────────────────────────────────── */
    .audit-list { display: grid; gap: 2px; background: rgba(255, 255, 255, 0.08); border-radius: var(--r-lg); overflow: hidden; }
    .audit-item { display: grid; gap: 14px; padding: 26px 20px; background: #071b14; transition: background 0.35s ease; }
    .audit-item:hover { background: #08241a; }
    @media (min-width: 640px) { .audit-item { padding: 30px 26px; gap: 18px; } }
    @media (min-width: 820px) { .audit-item { grid-template-columns: 84px 1fr; padding: 38px 34px; gap: 26px; } }
    .audit-num span { font-family: var(--mono); font-size: 26px; font-weight: 700; letter-spacing: -0.05em; color: var(--em-400); }
    @media (min-width: 640px) { .audit-num span { font-size: 30px; } }
    .audit-title { font-size: 18.5px; font-weight: 800; letter-spacing: -0.028em; line-height: 1.28; color: #fff; overflow-wrap: break-word; }
    @media (min-width: 700px) { .audit-title { font-size: 23px; letter-spacing: -0.03em; line-height: 1.25; } }
    .audit-split { margin-top: 18px; display: grid; gap: 18px; }
    @media (min-width: 900px) { .audit-split { grid-template-columns: 1fr 1fr; gap: 30px; } }
    .audit-split p { margin-top: 9px; font-size: 15px; line-height: 1.66; color: rgba(255, 255, 255, 0.62); }
    .audit-piste { border-left: 2px solid var(--em-600); padding-left: 18px; }
    .audit-piste p { color: rgba(255, 255, 255, 0.86); }
    .audit-foot { margin: 34px auto 0; max-width: 680px; text-align: center; font-size: 14.5px; line-height: 1.66; color: rgba(255, 255, 255, 0.62); }

    /* ── Plan 90 jours ──────────────────────────────────────────────────── */
    .plan-grid { display: grid; gap: 20px; }
    @media (min-width: 640px) { .plan-grid { gap: 24px; } }
    @media (min-width: 880px) { .plan-grid { grid-template-columns: repeat(3, 1fr); } }
    .plan { position: relative; overflow: hidden; transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), border-color 0.4s ease; }
    .plan:hover { transform: translateY(-4px); border-color: rgba(5, 150, 105, 0.3); }
    .plan::before {
      content: ""; position: absolute; left: 0; right: 0; top: 0; height: 3px;
      background: linear-gradient(to right, var(--em-500), var(--em-300));
      transform: scaleX(0); transform-origin: left;
      transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .plan:hover::before { transform: scaleX(1); }
    .plan-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
    .plan-num { font-family: var(--mono); font-size: 30px; font-weight: 700; letter-spacing: -0.05em; color: var(--em-600); line-height: 1; }
    .plan-duree { font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.16em; color: var(--ink-500); }
    .plan-title { margin-top: 18px; font-size: 22px; font-weight: 800; letter-spacing: -0.03em; }
    .plan-text { margin-top: 13px; font-size: 15px; line-height: 1.68; color: var(--ink-600); }

    /* ── Onglets CV ─────────────────────────────────────────────────────── */
    .tabs { padding: 0; overflow: hidden; }
    .tablist { display: flex; overflow-x: auto; border-bottom: 1px solid var(--line); background: var(--paper-2); scrollbar-width: none; }
    .tablist::-webkit-scrollbar { display: none; }
    .tab {
      appearance: none;
      background: transparent;
      border: 0;
      border-bottom: 2px solid transparent;
      padding: 17px 22px;
      font-family: var(--sans);
      font-size: 13.5px;
      font-weight: 700;
      color: var(--ink-500);
      cursor: pointer;
      white-space: nowrap;
      transition: color 0.2s ease, border-color 0.25s ease, background 0.2s ease;
    }
    .tab:hover { color: var(--ink); }
    .tab.is-active { color: var(--em-700); border-bottom-color: var(--em-600); background: var(--white); }
    .tabpanels { padding: 30px 24px 34px; }
    @media (min-width: 700px) { .tabpanels { padding: 38px; } }
    .tabpanel { display: none; }
    .tabpanel.is-active { display: block; animation: reveal 0.45s ease both; }

    .timeline { display: grid; gap: 30px; padding-left: 26px; border-left: 1px solid var(--line); }
    .timeline li { position: relative; }
    .tl-dot { position: absolute; left: -32px; top: 5px; width: 11px; height: 11px; border-radius: 999px; background: var(--em-500); box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.14); }
    .timeline h3 { margin-top: 8px; font-size: 18px; font-weight: 800; letter-spacing: -0.025em; }
    .timeline p { margin-top: 9px; font-size: 15px; line-height: 1.66; color: var(--ink-600); }

    .skills { display: grid; gap: 22px; }
    @media (min-width: 700px) { .skills { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 26px 34px; } }
    .skill { display: flex; gap: 14px; align-items: flex-start; }
    .skill-ico {
      flex: none;
      width: 38px; height: 38px;
      border-radius: 11px;
      display: inline-flex; align-items: center; justify-content: center;
      background: var(--em-50);
      border: 1px solid var(--em-200);
      color: var(--em-700);
      transition: background 0.3s ease, color 0.3s ease, transform 0.3s ease;
    }
    .skill-ico svg { width: 19px; height: 19px; display: block; }
    .skill:hover .skill-ico { background: var(--em-600); border-color: var(--em-600); color: #fff; transform: translateY(-2px); }
    .skill-body { min-width: 0; }
    .skill h3 { font-size: 16px; font-weight: 800; letter-spacing: -0.02em; padding-bottom: 9px; border-bottom: 1px solid var(--line); }
    .skill p { margin-top: 11px; font-size: 14.5px; line-height: 1.62; color: var(--ink-600); }

    .tools { display: flex; flex-wrap: wrap; gap: 9px; margin-top: 14px; }
    .tool {
      border: 1px solid var(--line);
      background: var(--paper-2);
      border-radius: 999px;
      padding: 8px 15px;
      font-family: var(--mono);
      font-size: 11.5px;
      letter-spacing: 0.04em;
      color: var(--ink-700);
      transition: border-color 0.25s ease, color 0.25s ease, transform 0.25s ease, background 0.25s ease;
    }
    .tool:hover { border-color: var(--em-400); color: var(--em-800); background: var(--em-50); transform: translateY(-2px); }
    /* ── Veille technique ───────────────────────────────────────────────── */
    .watch { margin-top: 34px; padding-top: 28px; border-top: 1px solid var(--line); }
    .watch-grid { margin-top: 16px; display: grid; gap: 14px; }
    @media (min-width: 900px) { .watch-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; } }
    .watch-card {
      border: 1px solid var(--line);
      border-radius: var(--r-md);
      background: var(--paper-2);
      padding: 18px 18px 20px;
      transition: border-color 0.3s ease, background 0.3s ease, transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .watch-card:hover { border-color: var(--em-300); background: var(--em-50); transform: translateY(-3px); }
    .watch-card h3 { font-size: 15px; font-weight: 800; letter-spacing: -0.02em; line-height: 1.3; }
    .watch-card p { margin-top: 10px; font-size: 13.5px; line-height: 1.62; color: var(--ink-600); }

    .watch-method { margin-top: 30px; padding-top: 24px; border-top: 1px solid var(--line); }
    .watch-method ul { margin-top: 14px; display: grid; gap: 10px; }
    .watch-method li {
      position: relative;
      padding-left: 22px;
      font-size: 14px;
      line-height: 1.6;
      color: var(--ink-600);
    }
    .watch-method li::before {
      content: "";
      position: absolute;
      left: 2px; top: 9px;
      width: 6px; height: 6px;
      border-radius: 999px;
      background: var(--em-500);
    }

    .proofs { display: grid; gap: 12px; }
    .proofs a {
      display: grid; gap: 5px;
      border: 1px solid var(--line);
      border-radius: var(--r-md);
      padding: 17px 20px;
      transition: border-color 0.25s ease, transform 0.25s ease, background 0.25s ease;
    }
    .proofs a:hover { border-color: var(--em-400); background: var(--em-50); transform: translateX(4px); }
    .proof-t { font-size: 15.5px; font-weight: 700; }
    .proof-d { font-size: 13.5px; color: var(--ink-500); }

    /* ── Lettre ─────────────────────────────────────────────────────────── */
    .letter { display: grid; gap: 16px; font-size: 15.5px; line-height: 1.72; color: var(--ink-700); position: relative; }
    .letter::before {
      content: "";
      position: absolute;
      left: 0; top: 26px; bottom: 26px;
      width: 3px;
      border-radius: 999px;
      background: linear-gradient(to bottom, var(--em-500), transparent);
    }
    @media (min-width: 640px) { .letter { gap: 18px; font-size: 16.5px; line-height: 1.75; } }
    @media (min-width: 700px) { .letter { padding: 46px 44px; } }
    .letter-sign {
      margin-top: 14px;
      padding-top: 22px;
      border-top: 1px solid var(--line);
      display: flex;
      align-items: center;
      gap: 14px;
      flex-wrap: wrap;
    }
    .sign-av {
      width: 56px; height: 56px;
      flex: none;
      border-radius: 999px;
      object-fit: cover;
      box-shadow: 0 0 0 2px var(--white), 0 0 0 3.5px var(--em-300);
    }
    .sign-id { display: grid; gap: 2px; min-width: 0; }
    .sign-id strong { font-size: 16.5px; letter-spacing: -0.02em; }
    .sign-id span { color: var(--ink-500); font-size: 13px; }
    .sign-cv {
      margin-left: auto;
      display: inline-flex; align-items: center; gap: 8px;
      border: 1px solid var(--line-strong);
      border-radius: 999px;
      padding: 9px 16px;
      font-size: 12.5px;
      font-weight: 700;
      background: var(--white);
      transition: border-color 0.25s ease, color 0.25s ease, transform 0.25s ease;
    }
    .sign-cv:hover { border-color: var(--em-600); color: var(--em-700); transform: translateY(-2px); }
    .sign-cv .ico { width: 15px; height: 15px; }

    /* ── Bloc CV : boutons PDF ──────────────────────────────────────────── */
    .cv-actions { margin-top: 26px; display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 10px 16px; }
    .sec-head-left .cv-actions { justify-content: flex-start; }
    .cv-actions-note { font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.16em; color: var(--ink-500); }
    .tl-foot { margin-top: 28px; padding-top: 22px; border-top: 1px solid var(--line); }

    /* ── Personnalité ───────────────────────────────────────────────────── */
    .trait-grid { display: grid; gap: 20px; }
    @media (min-width: 700px) { .trait-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @media (min-width: 1100px) { .trait-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; } }
    .trait { display: flex; flex-direction: column; transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), border-color 0.4s ease, box-shadow 0.4s ease; }
    .trait:hover { transform: translateY(-4px); border-color: rgba(5, 150, 105, 0.28); box-shadow: 0 24px 56px -30px rgba(10, 10, 10, 0.26); }
    .trait-title { margin-top: 14px; font-size: 18.5px; font-weight: 800; letter-spacing: -0.028em; line-height: 1.25; }
    .trait-text { margin-top: 13px; font-size: 14.5px; line-height: 1.68; color: var(--ink-600); }

    .trait-quote { margin: 34px auto 0; max-width: 720px; text-align: center; }
    .trait-quote blockquote {
      margin: 0;
      font-size: clamp(1.15rem, 3.4vw, 1.6rem);
      font-weight: 700;
      letter-spacing: -0.03em;
      line-height: 1.34;
      color: var(--ink);
      text-wrap: balance;
    }
    .trait-quote figcaption { margin-top: 16px; font-size: 14px; line-height: 1.6; color: var(--ink-500); }

    /* ── Objections ─────────────────────────────────────────────────────── */
    .obj-grid { display: grid; gap: 20px; }
    @media (min-width: 640px) { .obj-grid { gap: 24px; } }
    @media (min-width: 880px) { .obj-grid { grid-template-columns: repeat(2, 1fr); } }
    .obj { transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), border-color 0.4s ease; }
    .obj:hover { transform: translateY(-3px); border-color: rgba(5, 150, 105, 0.28); }
    .obj-q { display: flex; align-items: center; gap: 12px; font-size: 19px; font-weight: 800; letter-spacing: -0.025em; }
    .obj-mark {
      flex: none;
      width: 30px; height: 30px;
      border-radius: 9px;
      display: inline-flex; align-items: center; justify-content: center;
      background: var(--em-50);
      border: 1px solid var(--em-200);
      color: var(--em-700);
      font-family: var(--mono);
      font-size: 14px;
      font-weight: 700;
    }
    .obj-r { margin-top: 15px; font-size: 15.5px; line-height: 1.68; color: var(--ink-600); }

    /* ── Deux formules ──────────────────────────────────────────────────── */
    .offer-grid { display: grid; gap: 24px; max-width: 980px; margin: 0 auto; }
    @media (min-width: 880px) { .offer-grid { grid-template-columns: repeat(2, 1fr); } }
    .offer { display: flex; flex-direction: column; }
    .offer-hi { border-color: rgba(5, 150, 105, 0.34); box-shadow: 0 26px 70px -34px rgba(4, 120, 87, 0.5); }
    .offer-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 14px; }
    .offer-name { font-size: 22px; font-weight: 800; letter-spacing: -0.03em; }
    .offer-kind { font-size: 13px; color: var(--ink-500); margin-top: 3px; }
    .offer-tag {
      flex: none;
      border: 1px solid var(--line);
      background: var(--paper-2);
      border-radius: var(--r-sm);
      padding: 6px 11px;
      font-size: 10px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--ink-600);
    }
    .offer-tag-hi { background: var(--em-50); border-color: var(--em-200); color: var(--em-700); }
    .offer-price { margin-top: 20px; display: flex; align-items: baseline; gap: 8px; }
    .offer-price-num { font-family: var(--mono); font-size: clamp(46px, 9vw, 62px); font-weight: 700; letter-spacing: -0.05em; font-variant-numeric: tabular-nums; line-height: 1; }
    .offer-price-unit { font-size: 15px; font-weight: 600; color: var(--ink-500); }
    .offer-price-note { margin-top: 9px; font-size: 12.5px; color: var(--ink-500); }
    .offer-lead { margin-top: 22px; font-size: 15.5px; line-height: 1.66; color: var(--ink-600); }
    .offer-list { margin: 22px 0 28px; display: grid; gap: 11px; }
    .offer-list li { position: relative; padding-left: 27px; font-size: 14.5px; line-height: 1.55; color: var(--ink-700); }
    .offer-list li::before {
      content: "";
      position: absolute;
      left: 0; top: 5px;
      width: 15px; height: 15px;
      border-radius: 999px;
      background: var(--em-50);
      border: 1px solid var(--em-300);
    }
    .offer-list li::after {
      content: "";
      position: absolute;
      left: 4.5px; top: 9px;
      width: 6px; height: 3.5px;
      border-left: 1.8px solid var(--em-700);
      border-bottom: 1.8px solid var(--em-700);
      transform: rotate(-45deg);
    }
    .offer-foot { margin: 30px auto 0; max-width: 560px; text-align: center; font-size: 14px; color: var(--ink-500); }

    /* ── Contact ────────────────────────────────────────────────────────── */
    .contact { position: relative; overflow: hidden; background: linear-gradient(165deg, #043b2b 0%, #022c22 60%, #04150f 100%); color: #fff; padding: 76px 0; }
    @media (min-width: 640px) { .contact { padding: 96px 0; } }
    @media (min-width: 900px) { .contact { padding: 130px 0; } }
    .contact-inner { text-align: center; display: grid; justify-items: center; }
    .contact-title { margin-top: 22px; font-size: clamp(2rem, 8vw, 4.4rem); font-weight: 800; letter-spacing: -0.04em; line-height: 1.04; overflow-wrap: break-word; }
    @media (min-width: 640px) { .contact-title { margin-top: 26px; letter-spacing: -0.045em; line-height: 1.02; } }
    .contact-sub { margin-top: 20px; max-width: 520px; font-size: 16px; line-height: 1.62; color: rgba(255, 255, 255, 0.62); }
    @media (min-width: 640px) { .contact-sub { margin-top: 22px; font-size: 17px; } }
    .contact-actions { margin-top: 30px; display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; width: 100%; }
    @media (max-width: 419px) { .contact-actions { flex-direction: column; align-items: stretch; } .contact-actions .btn { width: 100%; } }
    @media (min-width: 640px) { .contact-actions { margin-top: 34px; gap: 12px; } }
    .contact-links { margin-top: 38px; padding-top: 18px; border-top: 1px solid rgba(255, 255, 255, 0.12); display: flex; flex-wrap: wrap; gap: 4px 20px; justify-content: center; width: 100%; max-width: 620px; }
    @media (min-width: 640px) { .contact-links { margin-top: 42px; gap: 6px 28px; } }
    .contact-links a {
      display: inline-block;
      padding: 8px 2px;
      font-family: var(--mono);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.16em;
      color: rgba(255, 255, 255, 0.55);
      transition: color 0.2s ease;
    }
    .contact-links a:hover { color: var(--em-300); }

    /* ── Footer ─────────────────────────────────────────────────────────── */
    .foot { background: #04150f; color: rgba(255, 255, 255, 0.62); padding: 30px 0; border-top: 1px solid rgba(255, 255, 255, 0.07); }
    .foot-inner { display: grid; gap: 6px; text-align: center; font-size: 12px; line-height: 1.6; }
    .foot-dim { color: rgba(255, 255, 255, 0.48); }

    /* ── FAB « appelez-moi » (calque du bouton LAIA de briveo.fr) ───────── */
    .fab {
      position: fixed;
      right: 16px;
      bottom: calc(16px + env(safe-area-inset-bottom));
      z-index: 70;
      border: 0;
      padding: 0;
      background: transparent;
      cursor: pointer;
      line-height: 0;
    }
    @media (min-width: 768px) { .fab { right: 24px; bottom: calc(24px + env(safe-area-inset-bottom)); } }
    .fab-glow {
      position: absolute;
      inset: 0;
      border-radius: 999px;
      background: linear-gradient(to bottom right, var(--em-400), var(--em-500));
      filter: blur(14px);
      opacity: 0.6;
      animation: fab-pulse 2.6s ease-in-out infinite;
      transition: opacity 0.3s ease;
    }
    .fab:hover .fab-glow { opacity: 0.85; }
    .fab-dot {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 56px; height: 56px;
      border-radius: 999px;
      background: linear-gradient(to bottom right, var(--em-500), var(--em-600));
      box-shadow: 0 18px 40px -12px rgba(4, 120, 87, 0.6);
      transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    }
    @media (min-width: 768px) { .fab-dot { width: 64px; height: 64px; } }
    .fab:hover .fab-dot { transform: scale(1.1); }
    .fab-ico { width: 24px; height: 24px; fill: none; stroke: #fff; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }
    @media (min-width: 768px) { .fab-ico { width: 27px; height: 27px; } }
    .fab-tip {
      position: absolute;
      bottom: calc(100% + 10px);
      left: 50%;
      transform: translateX(-50%);
      border-radius: 999px;
      background: var(--em-600);
      color: #fff;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 0.02em;
      padding: 3px 9px;
      white-space: nowrap;
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.25s ease;
      line-height: 1.6;
    }
    .fab:hover .fab-tip, .fab:focus-visible .fab-tip { opacity: 1; }
    body.is-locked { overflow: hidden; }

    /* ── Modale d'appel ─────────────────────────────────────────────────── */
    .modal { position: fixed; inset: 0; z-index: 100; display: flex; align-items: flex-end; justify-content: center; padding: 0; }
    .modal[hidden] { display: none; }
    @media (min-width: 640px) { .modal { align-items: center; padding: 24px; } }
    .modal-backdrop {
      position: absolute;
      inset: 0;
      background: rgba(4, 21, 15, 0.55);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      animation: fade-in 0.28s ease both;
    }
    .modal-card {
      position: relative;
      width: 100%;
      max-width: 480px;
      max-height: 92dvh;
      overflow-y: auto;
      background: var(--white);
      border: 1px solid var(--line);
      border-radius: 24px 24px 0 0;
      box-shadow: 0 40px 100px -30px rgba(4, 21, 15, 0.55);
      padding: 26px 22px calc(26px + env(safe-area-inset-bottom));
      animation: modal-in 0.36s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    @media (min-width: 640px) { .modal-card { border-radius: var(--r-xl); padding: 34px 32px; } }
    .modal-card:focus { outline: none; }
    .modal-x {
      position: absolute;
      top: 14px; right: 14px;
      width: 36px; height: 36px;
      display: inline-flex; align-items: center; justify-content: center;
      border: 1px solid var(--line);
      border-radius: 999px;
      background: var(--white);
      color: var(--ink-500);
      cursor: pointer;
      transition: color 0.2s ease, border-color 0.2s ease;
    }
    .modal-x:hover { color: var(--ink); border-color: var(--line-strong); }
    .modal-x .ico { width: 16px; height: 16px; }
    .modal-pill { margin-bottom: 18px; }
    .modal-title { font-size: clamp(1.5rem, 5.4vw, 1.95rem); font-weight: 800; letter-spacing: -0.035em; line-height: 1.1; }
    .modal-sub { margin-top: 14px; font-size: 15px; line-height: 1.62; color: var(--ink-600); }
    .modal-list { margin: 20px 0 24px; display: grid; gap: 11px; }
    .modal-list li { position: relative; padding-left: 26px; font-size: 14px; line-height: 1.55; color: var(--ink-700); }
    .modal-list li::before {
      content: "";
      position: absolute;
      left: 0; top: 4px;
      width: 15px; height: 15px;
      border-radius: 999px;
      background: var(--em-50);
      border: 1px solid var(--em-300);
    }
    .modal-list li::after {
      content: "";
      position: absolute;
      left: 4.5px; top: 8px;
      width: 6px; height: 3.5px;
      border-left: 1.8px solid var(--em-700);
      border-bottom: 1.8px solid var(--em-700);
      transform: rotate(-45deg);
    }
    .modal-call { margin-top: 0; }
    .modal-tel { font-family: var(--mono); font-weight: 700; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
    .modal-alt { margin-top: 16px; display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 6px 10px; font-size: 13px; color: var(--ink-500); }
    .modal-alt a { color: var(--ink-600); font-weight: 600; border-bottom: 1px solid var(--line-strong); padding-bottom: 1px; transition: color 0.2s ease, border-color 0.2s ease; }
    .modal-alt a:hover { color: var(--em-700); border-color: var(--em-600); }
    .modal-foot { margin-top: 14px; text-align: center; font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.16em; color: var(--ink-500); }

    /* ── Reveal au scroll ───────────────────────────────────────────────── */
    .reveal {
      opacity: 0;
      transform: translateY(18px);
      transition: opacity 0.75s cubic-bezier(0.22, 1, 0.36, 1), transform 0.75s cubic-bezier(0.22, 1, 0.36, 1);
      transition-delay: var(--d, 0ms);
    }
    .reveal.is-in { opacity: 1; transform: none; }

    /* ── Keyframes (repris de briveo.fr) ────────────────────────────────── */
    @keyframes live-pulse {
      0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
      100% { box-shadow: 0 0 0 10px rgba(16, 185, 129, 0); }
    }
    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-8px); }
    }
    @keyframes mesh-drift {
      0%, 100% { transform: translate(0) rotate(0deg); }
      33% { transform: translate(3%, -2%) rotate(1deg); }
      66% { transform: translate(-2%, 3%) rotate(-1deg); }
    }
    @keyframes shimmer {
      0% { background-position: -200% 0; }
      100% { background-position: 200% 0; }
    }
    @keyframes marquee {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }
    @keyframes bar-grow {
      0% { transform: scaleY(0); }
      100% { transform: scaleY(1); }
    }
    @keyframes caret {
      0%, 60% { opacity: 1; }
      61%, 100% { opacity: 0; }
    }
    @keyframes reveal {
      0% { opacity: 0; transform: translateY(10px); }
      100% { opacity: 1; transform: none; }
    }
    @keyframes menu-in {
      0% { opacity: 0; transform: translateY(-8px); }
      100% { opacity: 1; transform: none; }
    }
    @keyframes fab-pulse {
      0%, 100% { opacity: 0.6; transform: scale(1); }
      50% { opacity: 0.85; transform: scale(1.12); }
    }
    @keyframes fade-in { 0% { opacity: 0; } 100% { opacity: 1; } }
    @keyframes modal-in {
      0% { opacity: 0; transform: translateY(26px) scale(0.98); }
      100% { opacity: 1; transform: none; }
    }

    /* ── Accessibilité : on coupe tout si l'utilisateur le demande ──────── */
    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      *, *::before, *::after {
        animation-duration: 0.001ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.001ms !important;
      }
      .reveal { opacity: 1; transform: none; }
    }

    :focus-visible { outline: 2px solid var(--em-500); outline-offset: 3px; border-radius: 4px; }
    /* Les panneaux d'onglets sont focusables (ils défilent) mais ne doivent
       pas dessiner un cadre quand on arrive dessus au clic. */
    .tabpanel:focus { outline: none; }
    .tabpanel:focus-visible { outline: 2px solid var(--em-500); outline-offset: 6px; }

    .skip-link {
      position: absolute;
      left: 12px;
      top: -100px;
      z-index: 200;
      background: var(--em-700);
      color: #fff;
      font-size: 13px;
      font-weight: 700;
      padding: 12px 18px;
      border-radius: 999px;
      box-shadow: 0 14px 34px -12px rgba(4, 120, 87, 0.7);
      transition: top 0.25s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .skip-link:focus { top: 12px; }

    /* Le contraste des bordures et des libellés est relevé si l'utilisateur
       demande plus de contraste au niveau système. */
    @media (prefers-contrast: more) {
      :root {
        --ink-500: #5c5c5c;
        --line: rgba(23, 23, 23, 0.22);
        --line-strong: rgba(23, 23, 23, 0.34);
      }
    }
  </style>

  <script is:inline>
    (function () {
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* ── Barre de progression chapitrée + nav collante ─────────────── */
      var nav = document.getElementById('nav');
      var rail = document.getElementById('scrollRail');
      var segs = rail ? Array.prototype.slice.call(rail.querySelectorAll('.rail-seg')) : [];
      var nowLabel = document.getElementById('navNowLabel');
      var navLinks = Array.prototype.slice.call(document.querySelectorAll('.nav-links a, .mobile-menu nav a'));
      var bounds = [];
      var lastIndex = -1;

      // Les bornes sont recalculées à la mesure plutôt que codées en dur :
      // le contenu bouge selon la largeur (titres qui passent sur 2 lignes).
      function measure() {
        var max = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
        var tops = segs.map(function (s, i) {
          if (i === 0) return 0;
          var el = document.getElementById(s.getAttribute('data-target'));
          return el ? Math.min(el.offsetTop, max) : 0;
        });
        bounds = tops.map(function (t, i) {
          var end = i + 1 < tops.length ? tops[i + 1] : max;
          return { start: t, end: Math.max(end, t + 1) };
        });
        // Largeur du segment ∝ hauteur de scroll du chapitre.
        segs.forEach(function (s, i) {
          s.style.flexGrow = String(Math.max(bounds[i].end - bounds[i].start, 1));
        });
      }

      function paint() {
        var y = window.scrollY;
        var current = 0;
        for (var i = 0; i < bounds.length; i++) {
          if (y >= bounds[i].start) current = i;
        }
        segs.forEach(function (s, i) {
          var fill = s.querySelector('.rail-fill');
          var ratio = i < current ? 1
            : i > current ? 0
            : Math.min(1, Math.max(0, (y - bounds[i].start) / (bounds[i].end - bounds[i].start)));
          if (fill) fill.style.transform = 'scaleX(' + ratio + ')';
          s.classList.toggle('is-done', i < current);
        });
        if (current !== lastIndex) {
          lastIndex = current;
          var seg = segs[current];
          if (seg && nowLabel) nowLabel.textContent = seg.getAttribute('data-label');
          var target = seg ? '#' + seg.getAttribute('data-target') : '';
          navLinks.forEach(function (a) {
            a.classList.toggle('is-current', a.getAttribute('href') === target);
          });
        }
        if (nav) nav.classList.toggle('is-stuck', y > 8);
      }

      var ticking = false;
      function onScroll() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(function () { paint(); ticking = false; });
      }
      window.addEventListener('scroll', onScroll, { passive: true });

      var resizeTimer;
      window.addEventListener('resize', function () {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(function () { measure(); lastIndex = -1; paint(); }, 150);
      });
      // Les images se chargent après coup et décalent les offsets.
      window.addEventListener('load', function () { measure(); paint(); });

      // Au tap, la barre s'épaissit un instant : sans :hover, on ne devine
      // pas qu'elle est cliquable sur mobile.
      if (rail) {
        rail.addEventListener('touchstart', function () {
          rail.classList.add('is-touched');
          setTimeout(function () { rail.classList.remove('is-touched'); }, 1600);
        }, { passive: true });
      }

      measure();
      paint();

      /* ── Burger mobile ─────────────────────────────────────────────── */
      var burger = document.getElementById('burger');
      var menu = document.getElementById('mobileMenu');
      function setMenu(open) {
        if (!burger || !menu) return;
        menu.hidden = !open;
        burger.classList.toggle('is-open', open);
        burger.setAttribute('aria-expanded', open ? 'true' : 'false');
        burger.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
      }
      if (burger && menu) {
        burger.addEventListener('click', function () { setMenu(menu.hidden); });
        // Un clic sur une ancre referme : sinon le panneau masque la cible.
        menu.addEventListener('click', function (e) {
          if (e.target.closest('a')) setMenu(false);
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && !menu.hidden) { setMenu(false); burger.focus(); }
        });
        // Repasser en desktop avec le menu ouvert laisserait un panneau fantôme.
        window.matchMedia('(min-width: 940px)').addEventListener('change', function (e) {
          if (e.matches) setMenu(false);
        });
      }

      /* ── Reveal au scroll ──────────────────────────────────────────── */
      var revealables = document.querySelectorAll('.reveal');
      if (reduce || !('IntersectionObserver' in window)) {
        revealables.forEach(function (el) { el.classList.add('is-in'); });
      } else {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) {
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
        revealables.forEach(function (el) { io.observe(el); });
      }

      /* ── Compteurs animés (bandeau de chiffres, façon briveo.fr) ─────
         Easing exponentiel sortant : montée franche puis arrêt net sur la
         valeur, plutôt qu'un glissement mou en fin de course.             */
      var counters = document.querySelectorAll('[data-count]');
      function runCounter(el) {
        var target = parseFloat(el.getAttribute('data-count')) || 0;
        if (reduce) { el.textContent = String(target); return; }
        var start = performance.now();
        var dur = 1600;
        function tick(now) {
          var p = Math.min((now - start) / dur, 1);
          var eased = p === 1 ? 1 : 1 - Math.pow(2, -10 * p);
          el.textContent = String(Math.round(target * eased));
          if (p < 1) requestAnimationFrame(tick);
        }
        requestAnimationFrame(tick);
      }
      if ('IntersectionObserver' in window) {
        var cio = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { runCounter(e.target); cio.unobserve(e.target); }
          });
        }, { threshold: 0.5 });
        counters.forEach(function (el) { cio.observe(el); });
      } else {
        counters.forEach(runCounter);
      }

      /* ── Machine à écrire de la carte « Coach » ────────────────────── */
      var typed = document.getElementById('typed');
      var phrase = 'Ce profil coche les trois critères de l’annonce. Je recommande un entretien cette semaine.';
      if (typed) {
        if (reduce) {
          typed.textContent = phrase;
        } else {
          var i = 0;
          var startTyping = function () {
            var timer = setInterval(function () {
              typed.textContent = phrase.slice(0, i++);
              if (i > phrase.length) clearInterval(timer);
            }, 32);
          };
          setTimeout(startTyping, 1100);
        }
      }

      /* ── Modale d'appel ────────────────────────────────────────────── */
      var fab = document.getElementById('fab');
      var modal = document.getElementById('callModal');
      var modalCard = modal ? modal.querySelector('.modal-card') : null;
      function openModal() {
        if (!modal) return;
        modal.hidden = false;
        document.body.classList.add('is-locked');
        if (modalCard) modalCard.focus();
      }
      function closeModal() {
        if (!modal || modal.hidden) return;
        modal.hidden = true;
        document.body.classList.remove('is-locked');
        if (fab) fab.focus();
      }
      if (fab && modal) {
        fab.addEventListener('click', openModal);
        // Le fond ET la croix portent data-close ; le lien tel: referme aussi,
        // sinon on revient d'un appel avec la modale encore ouverte.
        modal.addEventListener('click', function (e) {
          if (e.target.closest('[data-close]') || e.target.closest('a')) closeModal();
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') { closeModal(); return; }
          // Piège de focus : sans lui, Tab sort de la modale et parcourt la
          // page derrière, que le lecteur d'écran ne devrait plus voir.
          if (e.key !== 'Tab' || modal.hidden || !modalCard) return;
          var f = modalCard.querySelectorAll('a[href], button:not([disabled])');
          if (!f.length) return;
          var first = f[0], last = f[f.length - 1];
          if (e.shiftKey && (document.activeElement === first || document.activeElement === modalCard)) {
            e.preventDefault(); last.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault(); first.focus();
          }
        });
      }

      /* ── Onglets du CV ─────────────────────────────────────────────── */
      var tabs = Array.prototype.slice.call(document.querySelectorAll('.tab'));
      tabs.forEach(function (tab, idx) {
        tab.addEventListener('click', function () {
          tabs.forEach(function (t) {
            t.classList.remove('is-active');
            t.setAttribute('aria-selected', 'false');
            // Roving tabindex : un seul onglet dans l'ordre de tabulation,
            // les flèches font le reste (pattern ARIA tabs).
            t.setAttribute('tabindex', '-1');
            var p = document.getElementById(t.getAttribute('aria-controls'));
            if (p) { p.classList.remove('is-active'); p.hidden = true; }
          });
          tab.classList.add('is-active');
          tab.setAttribute('aria-selected', 'true');
          tab.setAttribute('tabindex', '0');
          var panel = document.getElementById(tab.getAttribute('aria-controls'));
          if (panel) { panel.hidden = false; panel.classList.add('is-active'); }
        });
        tab.addEventListener('keydown', function (e) {
          var dir = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
          if (!dir) return;
          e.preventDefault();
          var next = tabs[(idx + dir + tabs.length) % tabs.length];
          next.focus();
          next.click();
        });
      });
    })();
  </script>
</body>
