---

<Layout
  title="CV — Florian Gertner Kilian | Product Designer (UI/UX)"
  description="Curriculum Vitae de Florian Gertner Kilian, Product Designer (UI/UX) à Nice (06200). Parcours, compétences design & développement, expériences et réalisations."
  canonical="/cv"
>
  <!-- Schema.org ProfilePage & Person -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    "name": "CV de Florian Gertner Kilian",
    "url": "https://wizyx.me/cv",
    "mainEntity": {
      "@type": "Person",
      "name": "Florian Gertner Kilian",
      "jobTitle": CONTACT.titre,
      "email": CONTACT.email,
      "telephone": CONTACT.telephoneHref,
      "url": CONTACT.portfolio,
      "address": {
        "@type": "PostalAddress",
        "postalCode": "06200",
        "addressLocality": "Nice",
        "addressRegion": "Provence-Alpes-Côte d'Azur",
        "addressCountry": "FR"
      },
      "alumniOf": ETUDES.map(e => ({
        "@type": "EducationalOrganization",
        "name": e.ecole,
        "url": e.ecoleUrl
      })),
      "sameAs": [
        CONTACT.linkedin,
        CONTACT.github,
        CONTACT.portfolio,
        CONTACT.calendly
      ]
    }
  })} />

  <main class="min-h-screen py-8 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto cv-page">
    
    <!-- BARRE D'OUTILS HAUTE (NON-IMPRIMABLE) -->
    <div class="no-print flex flex-wrap items-center justify-between gap-4 mb-6 pb-4 border-b border-gray-200 dark:border-white/10">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          Disponible pour opportunités & missions
        </span>
      </div>

      <div class="flex items-center gap-2.5 sm:gap-3 flex-wrap">
        <button
          onclick="window.print()"
          type="button"
          class="cursor-pointer inline-flex items-center gap-1.5 sm:gap-2 px-3.5 sm:px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold border border-brand-primary/30 dark:border-brand-secondary/40 text-brand-primary dark:text-brand-light hover:bg-brand-primary/10 transition-colors shadow-xs"
          title="Imprimer ou enregistrer en PDF"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 6 2 18 2 18 9"></polyline>
            <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
            <rect x="6" y="14" width="12" height="8"></rect>
          </svg>
          Imprimer / PDF
        </button>

        <a
          href={CONTACT.calendly}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 sm:gap-2 px-3.5 sm:px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold border border-purple-500/30 text-purple-600 dark:text-purple-400 hover:bg-purple-500/10 transition-colors shadow-xs"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          Prendre RDV
        </a>

        <a
          href="/contact"
          class="inline-flex items-center gap-1.5 sm:gap-2 px-3.5 sm:px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-brand-primary hover:bg-brand-hover text-white transition-colors shadow-xs"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
          Me contacter
        </a>
      </div>
    </div>

    <!-- CARTE PRINCIPALE DU CV -->
    <article class="cv-card card-bg rounded-2xl border border-[rgba(65,31,235,0.2)] dark:border-[rgba(85,54,237,0.25)] shadow-xl p-6 sm:p-10 transition-colors space-y-8">
      
      <!-- HEADER HERO DU CV -->
      <header class="flex flex-col md:flex-row items-center md:items-start justify-between gap-6 pb-6 border-b border-gray-200 dark:border-white/10">
        
        <div class="flex flex-col sm:flex-row items-center sm:items-start gap-5 text-center sm:text-left">
          <!-- Photo de profil avec contour gradient -->
          <div class="relative w-28 h-28 sm:w-32 sm:h-32 shrink-0 rounded-full p-1 bg-gradient-to-tr from-brand-primary to-purple-600 shadow-md">
            <Image
              src={profilePhoto}
              alt={CONTACT.nom}
              width={128}
              height={128}
              class="w-full h-full object-cover rounded-full"
              loading="eager"
            />
          </div>

          <div class="space-y-1">
            <h1 class="text-2xl sm:text-3xl font-extrabold text-dark-bg dark:text-white tracking-tight">
              {CONTACT.nom}
            </h1>
            <p class="text-xl sm:text-2xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-brand-primary to-purple-600 dark:from-brand-light dark:to-purple-400">
              {CONTACT.titre}
            </p>
            <p class="text-sm font-semibold text-gray-500 dark:text-gray-400 flex items-center justify-center sm:justify-start gap-1">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-brand-primary dark:text-brand-secondary">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              {CONTACT.lieu}
            </p>
          </div>
        </div>

        <!-- Coordonnées cliquables alignées à droite -->
        <div class="grid grid-cols-1 sm:grid-cols-2 md:flex md:flex-col gap-2 text-xs sm:text-sm text-gray-600 dark:text-gray-300">
          <a href={CONTACT.portfolio} class="inline-flex items-center gap-2 hover:text-brand-primary dark:hover:text-brand-secondary transition-colors font-medium group">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-brand-primary dark:text-brand-secondary shrink-0">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
            <span class="group-hover:underline">{CONTACT.portfolioLabel}</span>
          </a>

          <a href={CONTACT.linkedin} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 hover:text-brand-primary dark:hover:text-brand-secondary transition-colors font-medium group">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" class="text-brand-primary dark:text-brand-secondary shrink-0">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
            <span class="group-hover:underline">{CONTACT.linkedinLabel}</span>
          </a>

          <a href={CONTACT.github} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 hover:text-brand-primary dark:hover:text-brand-secondary transition-colors font-medium group">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" class="text-brand-primary dark:text-brand-secondary shrink-0">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
            <span class="group-hover:underline">{CONTACT.githubLabel}</span>
          </a>

          <a href={`mailto:${CONTACT.email}`} class="inline-flex items-center gap-2 hover:text-brand-primary dark:hover:text-brand-secondary transition-colors font-medium group">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-brand-primary dark:text-brand-secondary shrink-0">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            <span class="group-hover:underline">{CONTACT.email}</span>
          </a>

          <a href={`tel:${CONTACT.telephoneHref}`} class="inline-flex items-center gap-2 hover:text-brand-primary dark:hover:text-brand-secondary transition-colors font-medium group">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-brand-primary dark:text-brand-secondary shrink-0">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <span class="group-hover:underline">{CONTACT.telephone}</span>
          </a>
        </div>
      </header>

      <!-- BANDEAU CITATION / SEEK DISCOMFORT -->
      <div class="px-5 py-3 rounded-xl bg-gradient-to-r from-brand-primary to-[#7000FF] text-white flex items-center gap-3 shadow-sm">
        <span class="text-lg">⚡</span>
        <p class="text-xs sm:text-sm font-semibold tracking-wide italic">
          {CONTACT.citation}
        </p>
      </div>

      <!-- SECTION COMPÉTENCES -->
      <section class="space-y-4">
        <div class="flex items-center gap-2">
          <span class="inline-block px-3 py-1 rounded-md text-xs sm:text-sm font-bold bg-[#FFF000] text-black">
            Compétences
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-4">
          <!-- Outils & Domaines (8 cols) -->
          <div class="md:col-span-8 p-4 rounded-xl border border-gray-100 dark:border-white/5 bg-gray-50/60 dark:bg-white/[0.02] space-y-3">
            {COMPETENCES.map((comp) => (
              <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-2 text-xs sm:text-sm">
                <span class="font-bold text-dark-bg dark:text-white shrink-0 sm:w-56">
                  {comp.titre} :
                </span>
                <span class="text-gray-600 dark:text-gray-300">
                  {comp.outils.join(", ")}
                </span>
              </div>
            ))}
          </div>

          <!-- Soft skills (4 cols) -->
          <div class="md:col-span-4 p-4 rounded-xl border border-brand-primary/20 dark:border-brand-secondary/30 bg-brand-primary/[0.03] dark:bg-brand-secondary/[0.05] flex flex-col justify-center">
            <h3 class="text-xs font-bold text-brand-primary dark:text-brand-secondary uppercase tracking-wider mb-2">
              Savoir-être
            </h3>
            <ul class="space-y-1.5 text-xs sm:text-sm text-gray-700 dark:text-gray-300 font-medium">
              {SOFT_SKILLS.map((skill) => (
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-brand-primary shrink-0"></span>
                  <span>{skill}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <!-- SECTION EXPÉRIENCES PROFESSIONNELLES AVEC LIENS & ÉTUDES DE CAS -->
      <section class="space-y-4">
        <div class="flex items-center gap-2">
          <span class="inline-block px-3 py-1 rounded-md text-xs sm:text-sm font-bold bg-[#FFF000] text-black">
            Expériences professionnelles
          </span>
        </div>

        <div class="relative pl-6 sm:pl-8 space-y-6 before:content-[''] before:absolute before:left-2 sm:before:left-3 before:top-2 before:bottom-2 before:w-0.5 before:bg-brand-primary/40 dark:before:bg-brand-secondary/50">
          {EXPERIENCES.map((exp) => (
            <article class="relative space-y-1.5 group">
              <!-- Point timeline -->
              <span class="absolute -left-[23px] sm:-left-[27px] top-1.5 w-3 h-3 rounded-full bg-brand-primary border-2 border-white dark:border-dark-bg shadow-xs group-hover:scale-125 transition-transform"></span>

              <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                <div class="flex items-center gap-2.5 flex-wrap">
                  {exp.logo && (
                    <div class="w-6 h-6 rounded p-0.5 bg-white dark:bg-neutral-800 border border-gray-200 dark:border-white/10 shrink-0 inline-flex items-center justify-center">
                      <img src={exp.logo} alt={exp.entreprise} class="max-w-full max-h-full object-contain" loading="lazy" />
                    </div>
                  )}

                  {exp.siteUrl ? (
                    <a
                      href={exp.siteUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="font-bold text-sm sm:text-base text-dark-bg dark:text-white hover:text-brand-primary dark:hover:text-brand-secondary transition-colors inline-flex items-center gap-1 group/link"
                    >
                      <span>{exp.entreprise}</span>
                      <svg class="w-3.5 h-3.5 opacity-60 group-hover/link:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                      </svg>
                    </a>
                  ) : (
                    <h3 class="font-bold text-sm sm:text-base text-dark-bg dark:text-white">
                      {exp.entreprise}
                    </h3>
                  )}

                  <span class="text-xs sm:text-sm text-gray-500 dark:text-gray-400">
                    – {exp.type}
                  </span>

                  {exp.caseStudyUrl && (
                    <a
                      href={exp.caseStudyUrl}
                      class="no-print inline-flex items-center gap-1 text-[11px] font-semibold px-2 py-0.5 rounded-full bg-brand-primary/10 text-brand-primary dark:text-brand-light hover:bg-brand-primary/20 transition-colors"
                      title={`Voir ${exp.caseStudyLabel}`}
                    >
                      {exp.caseStudyLabel}
                      <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 12h14m-7-7 7 7-7 7" />
                      </svg>
                    </a>
                  )}
                </div>

                <div class="text-xs font-semibold text-brand-primary dark:text-brand-secondary shrink-0 sm:text-right">
                  <span>{exp.periode}</span>
                  <span class="block text-[11px] text-gray-400 dark:text-gray-500 font-normal">{exp.lieu}</span>
                </div>
              </div>

              <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-300 leading-relaxed pt-0.5">
                {exp.description}
              </p>
            </article>
          ))}
        </div>
      </section>

      <!-- SECTION ÉTUDES AVEC LIENS VERS LES ÉCOLES -->
      <section class="space-y-4">
        <div class="flex items-center gap-2">
          <span class="inline-block px-3 py-1 rounded-md text-xs sm:text-sm font-bold bg-[#FFF000] text-black">
            Études
          </span>
        </div>

        <div class="relative pl-6 sm:pl-8 space-y-5 before:content-[''] before:absolute before:left-2 sm:before:left-3 before:top-2 before:bottom-2 before:w-0.5 before:bg-brand-primary/40 dark:before:bg-brand-secondary/50">
          {ETUDES.map((etude) => (
            <article class="relative space-y-1 group">
              <!-- Point timeline -->
              <span class="absolute -left-[23px] sm:-left-[27px] top-1.5 w-3 h-3 rounded-full bg-brand-primary border-2 border-white dark:border-dark-bg shadow-xs group-hover:scale-125 transition-transform"></span>

              <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                <div class="flex items-center gap-2.5 flex-wrap">
                  {etude.logo ? (
                    <div class="w-6 h-6 rounded p-0.5 bg-white dark:bg-neutral-800 border border-gray-200 dark:border-white/10 shrink-0 inline-flex items-center justify-center">
                      <img src={etude.logo} alt={etude.ecole} class="max-w-full max-h-full object-contain" loading="lazy" />
                    </div>
                  ) : (
                    <div class="w-6 h-6 rounded bg-brand-primary/10 dark:bg-brand-secondary/20 text-brand-primary dark:text-brand-secondary font-bold text-[10px] shrink-0 inline-flex items-center justify-center">
                      {etude.mono}
                    </div>
                  )}

                  <h3 class="font-bold text-sm sm:text-base text-dark-bg dark:text-white">
                    {etude.titre}
                  </h3>
                </div>

                <div class="text-xs font-semibold text-brand-primary dark:text-brand-secondary shrink-0 sm:text-right">
                  <span>{etude.periode}</span>
                  {etude.ecoleUrl ? (
                    <a
                      href={etude.ecoleUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="block text-[11px] text-gray-500 hover:text-brand-primary dark:text-gray-400 dark:hover:text-brand-secondary transition-colors"
                    >
                      {etude.ecole} ↗
                    </a>
                  ) : (
                    <span class="block text-[11px] text-gray-400 dark:text-gray-500 font-normal">{etude.ecole}</span>
                  )}
                </div>
              </div>

              <p class="text-xs text-gray-500 dark:text-gray-400">
                {etude.precisions}
              </p>
            </article>
          ))}
        </div>
      </section>

      <!-- 3 COLONNES INFÉRIEURES : SPORTS, LANGUES, CENTRES D'INTÉRÊTS -->
      <section class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-2">
        
        <!-- SPORTS -->
        <div class="p-4 rounded-xl border border-gray-100 dark:border-white/5 bg-gray-50/60 dark:bg-white/[0.02] space-y-3">
          <span class="inline-block px-2.5 py-0.5 rounded text-xs font-bold bg-[#FFF000] text-black">
            Sports
          </span>

          <div class="space-y-2.5 text-xs sm:text-sm">
            {SPORTS.map((s) => (
              <div>
                <p class="font-bold text-dark-bg dark:text-white">{s.nom}</p>
                {s.details.map((d) => (
                  <p class="text-gray-600 dark:text-gray-400 text-xs">{d}</p>
                ))}
              </div>
            ))}
          </div>
        </div>

        <!-- LANGUES -->
        <div class="p-4 rounded-xl border border-gray-100 dark:border-white/5 bg-gray-50/60 dark:bg-white/[0.02] space-y-3">
          <span class="inline-block px-2.5 py-0.5 rounded text-xs font-bold bg-[#FFF000] text-black">
            Langues
          </span>

          <div class="space-y-2.5 text-xs sm:text-sm">
            {LANGUES.map((l) => (
              <div class="flex items-baseline justify-between border-b border-gray-200/50 dark:border-white/5 pb-1.5 last:border-none">
                <span class="font-bold text-dark-bg dark:text-white">{l.langue}</span>
                <span class="text-xs text-gray-600 dark:text-gray-400">{l.niveau}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- CENTRES D'INTÉRÊTS AVEC LIENS -->
        <div class="p-4 rounded-xl border border-gray-100 dark:border-white/5 bg-gray-50/60 dark:bg-white/[0.02] space-y-3">
          <span class="inline-block px-2.5 py-0.5 rounded text-xs font-bold bg-[#FFF000] text-black">
            Centres d'intérêts
          </span>

          <div class="space-y-2.5 text-xs">
            {CENTRES_INTERETS.map((ci) => (
              <div>
                <p class="font-bold text-dark-bg dark:text-white text-xs">{ci.categorie}</p>
                <ul class="text-gray-600 dark:text-gray-400 text-[11px] space-y-1 mt-0.5">
                  {ci.items.map((item) => (
                    <li class="flex items-start gap-1">
                      <span class="text-brand-primary">•</span>
                      {item.html ? (
                        <span set:html={item.html} />
                      ) : (
                        <span>{item.text}</span>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>

      </section>

    </article>

    <!-- FOOTER DU CV AVEC CALL TO ACTION (NON-IMPRIMABLE) -->
    <div class="no-print mt-10 text-center space-y-4">
      <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4">
        <a
          href="/contact"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl font-semibold bg-brand-primary hover:bg-brand-hover text-white transition-all shadow-md text-sm"
        >
          Discuter d'un projet
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>

        <a
          href={CONTACT.calendly}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl font-semibold border border-purple-500/40 text-purple-600 dark:text-purple-400 hover:bg-purple-500/10 transition-colors text-sm"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          Réserver 30 min (Calendly)
        </a>

        <a
          href="/creations"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl font-semibold border border-brand-primary/30 dark:border-brand-secondary/40 text-brand-primary dark:text-brand-light hover:bg-brand-primary/10 transition-colors text-sm"
        >
          Voir mes réalisations
        </a>
      </div>
    </div>

  </main>

  <style>
    /* STYLES SPÉCIFIQUES POUR L'IMPRESSION (PDF) */
    @media print {
      nav,
      footer,
      .no-print,
      #theme-toggle {
        display: none !important;
      }

      body {
        background: #ffffff !important;
        color: #111827 !important;
        font-size: 9.5pt !important;
        padding: 0 !important;
        margin: 0 !important;
      }

      .cv-page {
        max-width: 100% !important;
        padding: 0 !important;
        margin: 0 !important;
      }

      .cv-card {
        border: none !important;
        box-shadow: none !important;
        padding: 0 !important;
        background: transparent !important;
      }

      article, section {
        break-inside: avoid;
        page-break-inside: avoid;
      }

      a {
        text-decoration: none !important;
        color: inherit !important;
      }

      * {
        color-adjust: exact !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }
    }
  </style>
</Layout>
