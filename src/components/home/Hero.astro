---
// src/components/home/Hero.astro
import { Image } from "astro:assets";
import photoImg from "../../assets/media/photo.webp";
import phoqtvImg from "../../assets/media/brands/PHOQTV.svg";
import jobbrrImg from "../../assets/media/brands/JOBBRR.svg";
import digitalUnicornImg from "../../assets/media/brands/Digital Unicorn.svg";
import game4creatorImg from "../../assets/media/brands/Game4Creator.png";
import mafigueImg from "../../assets/media/brands/Mafigue.svg";
import client1 from "../../assets/media/photo/thibautmaensrabier.webp";
import client2 from "../../assets/media/photo/carolineaubert.webp";
import client3 from "../../assets/media/photo/lucaskacem.webp";

export interface Props {
    roundedCount?: number;
}
const { roundedCount = 20 } = Astro.props;
---

<!-- Header / Hero Section -->
<header
    class="text-white bg-[#411FEB] p-8 lg:px-32 transition-colors duration-200"
>
    <!-- Hero Content -->
    <div class="flex flex-col lg:flex-row items-stretch gap-4 mb-8">
        <!-- Image -->
        <div
            class="flex justify-start lg:justify-end lg:w-1/2 order-1 lg:order-2 mb-4"
        >
            <Image
                src={photoImg}
                alt="Photo de Florian Gertner Kilian"
                fetchpriority="high"
                loading="eager"
                class="h-full lg:max-h-[250px] rounded-xl shadow-lg object-cover"
                width="250"
                height="250"
            />
        </div>
        <!-- Texte -->
        <div
            class="lg:w-1/2 flex flex-col justify-center order-2 lg:order-1 gap-6"
        >
            <div>
                <h1 class="text-5xl font-bold">
                    Florian <span class="uppercase">Gertner Kilian</span>
                </h1>
                <h2
                    class="text-stroke lg:text-5xl text-4xl font-bold mt-2 min-h-[40px] lg:min-h-[48px]"
                >
                    <span id="typewriter"></span>
                </h2>
            </div>
            <div class="space-y-3">
                <p class="text-lg text-white/90">
                    Je transforme vos idées en produits performants
                </p>
                <!--<div class="flex items-center gap-2">
                    <div class="flex -space-x-1">
                        <div class="w-8 h-8 rounded-full border-2 border-[#411FEB] bg-[#251285] flex items-center justify-center overflow-hidden">
                            <Image src={client1} alt="Client" width={32} height={32} class="w-full h-full object-cover" />
                        </div>
                        <div class="w-8 h-8 rounded-full border-2 border-[#411FEB] bg-[#3215c7] flex items-center justify-center overflow-hidden relative z-10">
                            <Image src={client2} alt="Client" width={32} height={32} class="w-full h-full object-cover" />
                        </div>
                        <div class="w-8 h-8 rounded-full border-2 border-[#411FEB] bg-[#251285] flex items-center justify-center overflow-hidden relative z-20">
                            <Image src={client3} alt="Client" width={32} height={32} class="w-full h-full object-cover" />
                        </div>
                    </div>
                    <div class="flex flex-col">
                        <span class="text-sm font-medium text-white/90">10+ clients accompagnés et satisfaits</span>
                    </div>
                </div>-->
            </div>
            <div class="flex flex-wrap gap-4 mt-2">
                <a
                    href="/services/"
                    class="bg-white text-[#411FEB] px-6 py-3 font-semibold rounded-xl w-full lg:w-auto text-center transition-colors hover:bg-gray-100 hover:text-[#3215c7]"
                >
                    Alors, on collabore ?
                </a>
                <a
                    href="/creations/"
                    class="bg-white/10 text-white border border-white/20 px-6 py-3 font-semibold rounded-xl flex items-center justify-center gap-2 w-full md:w-auto transition-all hover:bg-white/20"
                >
                    Voir les projets clients
                    <i class="bx bx-arrow-up-right"></i>
                </a>
            </div>
        </div>
    </div>
    <!-- Brands -->
    <div class="overflow-hidden relative brands-carousel-wrapper">
        <div class="brands-scroll flex items-center gap-16 lg:gap-24">
            <!-- Logos will be automatically duplicated by brands_carousel.js -->
            <a
                href="https://www.phoq.tv"
                target="_blank"
                rel="noopener noreferrer"
                class="transition-opacity hover:opacity-80 flex-shrink-0"
            >
                <Image
                    src={phoqtvImg}
                    alt="PHOQ.tv"
                    class="h-8 w-auto object-contain"
                    loading="lazy"
                    decoding="async"
                />
            </a>
            <a
                href="https://jobbrr.io"
                target="_blank"
                rel="noopener noreferrer"
                class="transition-opacity hover:opacity-80 flex-shrink-0"
            >
                <Image
                    src={jobbrrImg}
                    alt="JOBBRR"
                    class="h-8 w-auto object-contain"
                    loading="lazy"
                    decoding="async"
                />
            </a>
            <a
                href="https://digitalunicorn.fr"
                target="_blank"
                rel="noopener noreferrer"
                class="transition-opacity hover:opacity-80 flex-shrink-0"
            >
                <Image
                    src={digitalUnicornImg}
                    alt="Digital Unicorn"
                    class="h-8 w-auto object-contain"
                    loading="lazy"
                    decoding="async"
                />
            </a>
            <a
                href="https://game4creator.com"
                target="_blank"
                rel="noopener noreferrer"
                class="transition-opacity hover:opacity-80 flex-shrink-0"
            >
                <Image
                    src={game4creatorImg}
                    alt="Game4Creator"
                    class="h-8 w-auto object-contain"
                    loading="lazy"
                    decoding="async"
                />
            </a>
            <a
                href="https://www.mafigue.com"
                target="_blank"
                rel="noopener noreferrer"
                class="transition-opacity hover:opacity-80 flex-shrink-0"
            >
                <Image
                    src={mafigueImg}
                    alt="Mafigue"
                    class="h-8 w-auto object-contain"
                    loading="lazy"
                    decoding="async"
                />
            </a>
        </div>
    </div>
</header>
