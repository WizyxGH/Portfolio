---
// src/components/home/Testimonials.astro
import { Image } from 'astro:assets';
import lucasKacem from '../../assets/media/photo/lucaskacem.webp';
import aurelienPalasse from '../../assets/media/photo/aurelienpalasse.webp';
import carolineAubert from '../../assets/media/photo/carolineaubert.webp';
import jonathanVaissiere from '../../assets/media/photo/jonathanvaissiere.webp';
import maximeClick from '../../assets/media/photo/maximeclick.webp';
import thibautMaens from '../../assets/media/photo/thibautmaensrabier.webp';
import uncleSam from '../../assets/media/photo/unclesam.webp';

const testimonials = [
  {
    name: "Lucas Kacem",
    role: `Co-fondateur & Président, <a href="https://digitalunicorn.fr" target="_blank" rel="noopener noreferrer" class="hover:underline font-semibold text-brand-primary dark:text-brand-secondary">Digital Unicorn</a>`,
    linkedin: "https://www.linkedin.com/in/lucas-kacem/",
    image: lucasKacem,
    text: `"Florian a fait son stage chez Digital Unicorn en tant que UI/UX Designer et ça a été un vrai plaisir de travailler avec lui. Super impliqué, intelligent et toujours dans l’action, il a vraiment apporté de la valeur à l’équipe. 🚀"`
  },
  {
    name: "Aurélien Palasse",
    role: `Managing Director, <a href="https://www.ubisoft.com/fr-fr/company/careers/locations/da-nang" target="_blank" rel="noopener noreferrer" class="hover:underline font-semibold text-brand-primary dark:text-brand-secondary">Ubisoft Vietnam</a>`,
    image: aurelienPalasse,
    text: `"Coming soon..."`
  },
  {
    name: "Caroline Aubert",
    role: `<a href="https://www.mafigue.com" target="_blank" rel="noopener noreferrer" class="hover:underline font-semibold text-brand-primary dark:text-brand-secondary">Entrepreneuse</a>, Product Designer & Développeuse Webflow`,
    linkedin: "https://www.linkedin.com/in/caroline-aubert-mafigue/",
    image: carolineAubert,
    fulltext: `J'ai eu la chance d'avoir Florian en stage pendant deux mois dans ma structure. Je dis bien la chance, car ma première expérience d'avoir des stagiaires a été un succès grâce à lui. Motivé, hyper proactif, enseignable, il a su, dès les premiers jours, être opérationnel. Il a une très bonne appétence pour tout ce qui touche au rédactionnel. Il est force de proposition et sait répondre à des briefs client quasiment en autonomie. Je peux dire qu'il est aujourd'hui expert en autolayout sur Figma et sait utiliser cet outil de manière professionnelle. Je recommande son profil à l'embauche si vous souhaitez ne pas prendre de risque puisqu'il coche toutes les cases. Ce sera une force dans vos équipes.`
  },
  {
    name: "Jonathan Vaissière",
    role: `Entrepreneur, <a href="https://guidedugolfe.com" target="_blank" rel="noopener noreferrer" class="hover:underline font-semibold text-brand-primary dark:text-brand-secondary">Le Guide du Golfe de Saint-Tropez</a>`,
    linkedin: "https://www.linkedin.com/in/jonathan-vaissiere/",
    image: jonathanVaissiere,
    fulltext: `Un travail pro et sérieux comme on aime et surtout comme on a BESOIN ! Florian a fait parti de l’équipe qui nous a conçu les maquettes de notre dernière version et ce fut un régal de travailler ensemble. De part les outils proposés mais surtout dans la façon. Rapide, efficace et agréable. Merci encore pour ton travail👏🏼✨`
  },
  {
    name: `Maxime "Click" Peiffer`,
    role: `Créateur de contenu (1.1M sur YouTube)`,
    youtube: "https://www.youtube.com/@MaximeClick",
    image: maximeClick,
    text: `"Je l'ai vu direct !! Très fort 🔥"`
  },
  {
    name: "Thibaut Maëns Rabier",
    role: `Founder & Creative Producer, <a href="https://phoq.tv" target="_blank" rel="noopener noreferrer" class="hover:underline font-semibold text-brand-primary dark:text-brand-secondary">PHOQ.tv</a>`,
    image: thibautMaens,
    text: `"Coming soon..."`
  },
  {
    name: "Vous",
    role: `Une personne sûrement sympathique`,
    image: uncleSam,
    text: `"Une idée, un projet en tête ? Et si c’était votre tour ! On en discute ? (ça n’engage en rien et je serai ravi d’en discuter)"`,
    isVous: true
  }
];

const half = Math.ceil(testimonials.length / 2);
const testimonialsRow1 = testimonials.slice(0, half);
const testimonialsRow2 = testimonials.slice(half);

const cardClass = "w-[320px] md:w-[400px] shrink-0 bg-brand-muted dark:bg-brand-secondary/10 border-2 border-brand-light dark:border-[#281E5A] p-6 rounded-2xl flex flex-col justify-between transition-all duration-600 transform hover:scale-[1.02] hover:shadow-xl hover:border-brand-primary dark:hover:border-brand-secondary group";
const vousCardClass = "w-[320px] md:w-[400px] shrink-0 bg-[#F8F6FE] dark:bg-brand-secondary/10 border-dashed border-2 border-brand-light dark:border-[#29197F] p-6 rounded-2xl flex flex-col justify-between transition-all duration-600 transform hover:scale-[1.02] hover:shadow-xl hover:border-brand-primary dark:hover:border-brand-secondary group";
---
<!-- Testimonials Section -->
<section class="pt-8 px-8 pb-16 lg:pt-8 lg:pb-24 text-center space-y-8 overflow-hidden">
    <div>
        <h2 class="text-2xl text-dark-bg dark:text-white font-medium mb-4">
            On a travaillé ensemble et
            <br>ils me recommandent.
        </h2>
        <div class="inline-flex items-center gap-2 rounded-full bg-brand-primary px-4 py-1.5 text-white">
            <i class='bx bxs-wink-smile'></i>
            <span class="text-sm font-semibold">Un impact positif partout où je passe</span>
        </div>
    </div>
    
    <div class="flex flex-col gap-6 relative w-full text-left animate-on-scroll opacity-0 translate-y-10">

        <!-- Ligne 1 (Défilement vers la gauche) -->
        <div class="flex w-max animation-marquee hover:[animation-play-state:paused]">
            <!-- Original -->
            <div class="flex gap-6 w-max pr-6">
                {testimonialsRow1.map((t) => (
                    <div class={`${t.fulltext ? 'testimonial ' : ''}${t.isVous ? vousCardClass : cardClass}`} data-fulltext={t.fulltext}>
                        <div class="flex flex-col">
                            <div class="flex items-center justify-between mb-4">
                                <div class="text-brand-primary/20 dark:text-brand-secondary/20 text-3xl transition-colors group-hover:text-brand-primary dark:group-hover:text-brand-secondary">
                                    <i class='bx bxs-quote-left'></i>
                                </div>
                                <div class="flex gap-0.5 text-yellow-400 text-sm">
                                    <i class='bx bxs-star'></i><i class='bx bxs-star'></i><i class='bx bxs-star'></i><i class='bx bxs-star'></i><i class='bx bxs-star'></i>
                                </div>
                            </div>
                            <p class={`${t.fulltext ? 'testimonial-text ' : ''}text-sm text-gray-600 dark:text-gray-300 leading-relaxed italic mb-4`}>
                                {t.text && t.text}
                            </p>
                        </div>
                        <div class="flex items-center gap-3 mt-auto">
                            <Image src={t.image} alt={t.name} class="w-10 h-10 rounded-full object-cover shrink-0" width={40} height={40} loading="lazy" decoding="async" />
                            <div>
                                <h4 class="font-bold text-sm text-brand-primary dark:text-brand-secondary">
                                    {t.linkedin ? (
                                        <a href={t.linkedin} target="_blank" rel="noopener noreferrer" class="hover:underline inline-flex items-center gap-1">
                                            {t.name} <i class='bx bxl-linkedin-square text-sm opacity-70 hover:opacity-100'></i>
                                        </a>
                                    ) : t.youtube ? (
                                        <a href={t.youtube} target="_blank" rel="noopener noreferrer" class="hover:underline inline-flex items-center gap-1">
                                            {t.name} <i class='bx bxl-youtube text-sm opacity-70 hover:opacity-100'></i>
                                        </a>
                                    ) : (
                                        t.name
                                    )}
                                </h4>
                                <p class="text-xs text-gray-500 dark:text-gray-400" set:html={t.role}></p>
                            </div>
                        </div>
                    </div>
                ))}
            </div>
            <!-- Duplicata pour boucle infinie -->
            <div class="flex gap-6 w-max pr-6" aria-hidden="true">
                {testimonialsRow1.map((t) => (
                    <div class={`${t.fulltext ? 'testimonial ' : ''}${t.isVous ? vousCardClass : cardClass}`} data-fulltext={t.fulltext}>
                        <div class="flex flex-col">
                            <div class="flex items-center justify-between mb-4">
                                <div class="text-brand-primary/20 dark:text-brand-secondary/20 text-3xl transition-colors group-hover:text-brand-primary dark:group-hover:text-brand-secondary">
                                    <i class='bx bxs-quote-left'></i>
                                </div>
                                <div class="flex gap-0.5 text-yellow-400 text-sm">
                                    <i class='bx bxs-star'></i><i class='bx bxs-star'></i><i class='bx bxs-star'></i><i class='bx bxs-star'></i><i class='bx bxs-star'></i>
                                </div>
                            </div>
                            <p class={`${t.fulltext ? 'testimonial-text ' : ''}text-sm text-gray-600 dark:text-gray-300 leading-relaxed italic mb-4`}>
                                {t.text && t.text}
                            </p>
                        </div>
                        <div class="flex items-center gap-3 mt-auto">
                            <Image src={t.image} alt={t.name} class="w-10 h-10 rounded-full object-cover shrink-0" width={40} height={40} loading="lazy" decoding="async" />
                            <div>
                                <h4 class="font-bold text-sm text-brand-primary dark:text-brand-secondary">
                                    {t.linkedin ? (
                                        <a href={t.linkedin} target="_blank" rel="noopener noreferrer" class="hover:underline inline-flex items-center gap-1">
                                            {t.name} <i class='bx bxl-linkedin-square text-sm opacity-70 hover:opacity-100'></i>
                                        </a>
                                    ) : t.youtube ? (
                                        <a href={t.youtube} target="_blank" rel="noopener noreferrer" class="hover:underline inline-flex items-center gap-1">
                                            {t.name} <i class='bx bxl-youtube text-sm opacity-70 hover:opacity-100'></i>
                                        </a>
                                    ) : (
                                        t.name
                                    )}
                                </h4>
                                <p class="text-xs text-gray-500 dark:text-gray-400" set:html={t.role}></p>
                            </div>
                        </div>
                    </div>
                ))}
            </div>
        </div>

        <!-- Ligne 2 (Défilement vers la droite) -->
        <div class="flex w-max animation-marquee-reverse hover:[animation-play-state:paused]">
            <!-- Original -->
            <div class="flex gap-6 w-max pr-6">
                {testimonialsRow2.map((t) => (
                    <div class={`${t.fulltext ? 'testimonial ' : ''}${t.isVous ? vousCardClass : cardClass}`} data-fulltext={t.fulltext}>
                        <div class="flex flex-col">
                            <div class="flex items-center justify-between mb-4">
                                <div class="text-brand-primary/20 dark:text-brand-secondary/20 text-3xl transition-colors group-hover:text-brand-primary dark:group-hover:text-brand-secondary">
                                    <i class='bx bxs-quote-left'></i>
                                </div>
                                <div class="flex gap-0.5 text-yellow-400 text-sm">
                                    <i class='bx bxs-star'></i><i class='bx bxs-star'></i><i class='bx bxs-star'></i><i class='bx bxs-star'></i><i class='bx bxs-star'></i>
                                </div>
                            </div>
                            <p class={`${t.fulltext ? 'testimonial-text ' : ''}text-sm text-gray-600 dark:text-gray-300 leading-relaxed italic mb-4`}>
                                {t.text && t.text}
                            </p>
                        </div>
                        <div class="flex items-center gap-3 mt-auto">
                            <Image src={t.image} alt={t.name} class="w-10 h-10 rounded-full object-cover shrink-0" width={40} height={40} loading="lazy" decoding="async" />
                            <div>
                                <h4 class="font-bold text-sm text-brand-primary dark:text-brand-secondary">
                                    {t.linkedin ? (
                                        <a href={t.linkedin} target="_blank" rel="noopener noreferrer" class="hover:underline inline-flex items-center gap-1">
                                            {t.name} <i class='bx bxl-linkedin-square text-sm opacity-70 hover:opacity-100'></i>
                                        </a>
                                    ) : t.youtube ? (
                                        <a href={t.youtube} target="_blank" rel="noopener noreferrer" class="hover:underline inline-flex items-center gap-1">
                                            {t.name} <i class='bx bxl-youtube text-sm opacity-70 hover:opacity-100'></i>
                                        </a>
                                    ) : (
                                        t.name
                                    )}
                                </h4>
                                <p class="text-xs text-gray-500 dark:text-gray-400" set:html={t.role}></p>
                            </div>
                        </div>
                    </div>
                ))}
            </div>
            <!-- Duplicata pour boucle infinie -->
            <div class="flex gap-6 w-max pr-6" aria-hidden="true">
                {testimonialsRow2.map((t) => (
                    <div class={`${t.fulltext ? 'testimonial ' : ''}${t.isVous ? vousCardClass : cardClass}`} data-fulltext={t.fulltext}>
                        <div class="flex flex-col">
                            <div class="flex items-center justify-between mb-4">
                                <div class="text-brand-primary/20 dark:text-brand-secondary/20 text-3xl transition-colors group-hover:text-brand-primary dark:group-hover:text-brand-secondary">
                                    <i class='bx bxs-quote-left'></i>
                                </div>
                                <div class="flex gap-0.5 text-yellow-400 text-sm">
                                    <i class='bx bxs-star'></i><i class='bx bxs-star'></i><i class='bx bxs-star'></i><i class='bx bxs-star'></i><i class='bx bxs-star'></i>
                                </div>
                            </div>
                            <p class={`${t.fulltext ? 'testimonial-text ' : ''}text-sm text-gray-600 dark:text-gray-300 leading-relaxed italic mb-4`}>
                                {t.text && t.text}
                            </p>
                        </div>
                        <div class="flex items-center gap-3 mt-auto">
                            <Image src={t.image} alt={t.name} class="w-10 h-10 rounded-full object-cover shrink-0" width={40} height={40} loading="lazy" decoding="async" />
                            <div>
                                <h4 class="font-bold text-sm text-brand-primary dark:text-brand-secondary">
                                    {t.linkedin ? (
                                        <a href={t.linkedin} target="_blank" rel="noopener noreferrer" class="hover:underline inline-flex items-center gap-1">
                                            {t.name} <i class='bx bxl-linkedin-square text-sm opacity-70 hover:opacity-100'></i>
                                        </a>
                                    ) : t.youtube ? (
                                        <a href={t.youtube} target="_blank" rel="noopener noreferrer" class="hover:underline inline-flex items-center gap-1">
                                            {t.name} <i class='bx bxl-youtube text-sm opacity-70 hover:opacity-100'></i>
                                        </a>
                                    ) : (
                                        t.name
                                    )}
                                </h4>
                                <p class="text-xs text-gray-500 dark:text-gray-400" set:html={t.role}></p>
                            </div>
                        </div>
                    </div>
                ))}
            </div>
        </div>

    </div>
</section>

<style>
.animation-marquee {
    animation: marquee 40s linear infinite;
    will-change: transform;
}
.animation-marquee-reverse {
    animation: marquee-reverse 35s linear infinite;
    will-change: transform;
}
@keyframes marquee {
    0% { transform: translate3d(0, 0, 0); }
    100% { transform: translate3d(-50%, 0, 0); }
}
@keyframes marquee-reverse {
    0% { transform: translate3d(-50%, 0, 0); }
    100% { transform: translate3d(0, 0, 0); }
}
</style>
