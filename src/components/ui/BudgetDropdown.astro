---
// Composant déroulant custom pour le Budget
---
<div class="relative mt-1 w-full">
    <input type="hidden" name="budget" id="budgetSelect" value="" required />
    <button type="button" id="budgetSelectBtn" class="w-full p-3 border-2 border-[#3E3E3E]/20 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-primary dark:focus:ring-brand-secondary bg-white text-gray-800 dark:bg-dark-bg dark:border-[#3E3E3E] text-left transition-colors cursor-pointer flex justify-between items-center">
        <span id="budgetSelectedText" class="text-gray-400 dark:text-gray-500">Sélectionnez une tranche...</span>
        <i class='bx bx-chevron-down text-xl text-gray-500'></i>
    </button>

    <ul id="budgetList" class="hidden absolute top-full left-0 mt-1 w-full bg-white dark:bg-[#1A1A1A] border border-[#3E3E3E]/20 dark:border-[#3E3E3E] rounded-xl shadow-lg z-50 overflow-hidden py-1">
        <li class="budget-option p-3 hover:bg-gray-100 dark:hover:bg-[#2A2A2A] cursor-pointer transition-colors text-sm font-medium text-gray-800 dark:text-gray-200" data-value="Moins de 1 000 €">Moins de 1 000 €</li>
        <li class="budget-option p-3 hover:bg-gray-100 dark:hover:bg-[#2A2A2A] cursor-pointer transition-colors text-sm font-medium text-gray-800 dark:text-gray-200" data-value="1 000 € - 3 000 €">1 000 € - 3 000 €</li>
        <li class="budget-option p-3 hover:bg-gray-100 dark:hover:bg-[#2A2A2A] cursor-pointer transition-colors text-sm font-medium text-gray-800 dark:text-gray-200" data-value="3 000 € - 6 000 €">3 000 € - 6 000 €</li>
        <li class="budget-option p-3 hover:bg-gray-100 dark:hover:bg-[#2A2A2A] cursor-pointer transition-colors text-sm font-medium text-gray-800 dark:text-gray-200" data-value="6 000 € - 10 000 €">6 000 € - 10 000 €</li>
        <li class="budget-option p-3 hover:bg-gray-100 dark:hover:bg-[#2A2A2A] cursor-pointer transition-colors text-sm font-medium text-gray-800 dark:text-gray-200" data-value="10 000 € - 20 000 €">10 000 € - 20 000 €</li>
        <li class="budget-option p-3 hover:bg-gray-100 dark:hover:bg-[#2A2A2A] cursor-pointer transition-colors text-sm font-medium text-gray-800 dark:text-gray-200" data-value="Plus de 20 000 €">Plus de 20 000 €</li>
    </ul>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const btn = document.getElementById("budgetSelectBtn");
        const list = document.getElementById("budgetList");
        const input = document.getElementById("budgetSelect") as HTMLInputElement;
        const selectedText = document.getElementById("budgetSelectedText");
        const options = document.querySelectorAll(".budget-option");

        if (btn && list) {
            btn.addEventListener("click", (e) => {
                e.preventDefault();
                e.stopPropagation();
                list.classList.toggle("hidden");
            });

            document.addEventListener("click", (e) => {
                if (!btn.contains(e.target as Node) && !list.contains(e.target as Node)) {
                    list.classList.add("hidden");
                }
            });

            options.forEach((option) => {
                option.addEventListener("click", () => {
                    const value = option.getAttribute("data-value");

                    if (value && input && selectedText) {
                        input.value = value;
                        selectedText.textContent = value;
                        selectedText.classList.remove("text-gray-400", "dark:text-gray-500");
                        selectedText.classList.add("text-gray-800", "dark:text-white");
                        
                        options.forEach(opt => opt.classList.remove("bg-gray-100", "dark:bg-[#2A2A2A]"));
                        option.classList.add("bg-gray-100", "dark:bg-[#2A2A2A]");
                        
                        list.classList.add("hidden");
                        
                        // Déclencher l'event change pour la validation dans contact.js
                        input.dispatchEvent(new Event("change", { bubbles: true }));
                    }
                });
            });
        }
    });
</script>
