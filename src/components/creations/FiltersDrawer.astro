---
// src/components/creations/FiltersDrawer.astro
---
<div id="filtersDrawer" class="fixed inset-0 z-50 invisible">
    <div class="drawer-overlay absolute inset-0 bg-black/50 opacity-0 transition-opacity duration-300"></div>
    <div class="drawer-content absolute inset-x-0 bottom-0 h-[85vh] w-full rounded-t-3xl sm:top-0 sm:right-0 sm:bottom-0 sm:left-auto sm:h-full sm:w-[450px] sm:rounded-none bg-white dark:bg-dark-bg transform translate-y-full sm:translate-y-0 sm:translate-x-full transition-transform duration-300 flex flex-col shadow-2xl overflow-hidden">
        
        <!-- Header -->
        <div class="p-6 border-b border-gray-100 dark:border-[#3E3E3E] flex justify-between items-center bg-white dark:bg-dark-bg shrink-0">
            <h2 class="text-xl font-bold text-brand-primary dark:text-white flex items-center gap-2">
                <i class='bx bx-slider-alt text-2xl'></i> Filtres & Tri
            </h2>
            <button id="closeFiltersBtn" class="text-gray-500 hover:text-brand-primary dark:hover:text-brand-secondary transition-colors p-1 rounded-full hover:bg-gray-100 dark:hover:bg-white/5">
                <i class='bx bx-x text-3xl leading-none'></i>
            </button>
        </div>

        <!-- Body -->
        <div class="flex-1 overflow-y-auto p-6 space-y-8 custom-scrollbar">
            <div>
                <h3 class="text-sm font-semibold text-gray-400 uppercase tracking-wider mb-3">Trier par</h3>
                <div id="drawerSortContainer" class="flex flex-wrap gap-2"></div>
            </div>
            
            <div>
                <h3 class="text-sm font-semibold text-gray-400 uppercase tracking-wider mb-3">Catégories</h3>
                <div id="drawerTypesContainer" class="flex flex-wrap gap-2"></div>
            </div>
            
            <div>
                <h3 class="text-sm font-semibold text-gray-400 uppercase tracking-wider mb-3">Compétences</h3>
                <div id="drawerTagsContainer" class="flex flex-wrap gap-2"></div>
            </div>
        </div>

        <!-- Footer -->
        <div class="p-6 border-t border-gray-100 dark:border-[#3E3E3E] bg-white dark:bg-dark-bg shrink-0">
            <button id="applyFiltersBtn" class="w-full py-3 bg-brand-primary text-white rounded-xl font-semibold hover:bg-[#3A1CC5] transition-colors flex justify-center items-center gap-2 shadow-lg">
                Afficher les résultats 
                <span id="resultsCountBadge" class="bg-white/20 text-white px-2 py-0.5 rounded-full text-xs font-bold min-w-[24px] text-center">...</span>
            </button>
        </div>

    </div>
</div>

<style>
.custom-scrollbar::-webkit-scrollbar {
    width: 6px;
}
.custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
}
.custom-scrollbar::-webkit-scrollbar-thumb {
    background-color: rgba(156, 163, 175, 0.3);
    border-radius: 10px;
}
.dark .custom-scrollbar::-webkit-scrollbar-thumb {
    background-color: rgba(255, 255, 255, 0.1);
}
</style>
