---
// src/components/creations/CreationsHeader.astro
import FiltersDrawer from './FiltersDrawer.astro';
---
<header class="bg-brand-primary p-8 lg:px-32 lg:py-12">
    <div class="relative w-full max-w-3xl mx-auto">
        <i class='bx bx-search absolute left-5 top-1/2 -translate-y-1/2 text-[#3E3E3E] dark:text-white text-xl'></i>
        <input type="text" id="searchInput" placeholder="Rechercher parmi les projets"
            class="w-full pl-12 pr-24 py-3 rounded-xl border-2 border-[#3E3E3E]/20 bg-white dark:bg-dark-bg dark:border-[#3E3E3E] dark:text-white dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-brand-primary placeholder-gray-400 text-gray-800" />
        
        <button id="clearSearch"
            class="absolute right-14 top-1/2 transform -translate-y-1/2 text-[#3E3E3E] dark:text-white opacity-0 pointer-events-none transition-opacity p-1 hover:text-brand-primary dark:hover:text-brand-secondary">
            <i class='bx bx-x text-xl leading-none'></i>
        </button>

        <!-- Bouton Filtres intégré au champ -->
        <button id="openFiltersBtn" class="absolute right-2 top-1/2 transform -translate-y-1/2 h-10 w-10 flex items-center justify-center rounded-lg bg-gray-100 hover:bg-gray-200 dark:bg-white/10 dark:hover:bg-white/20 text-[#3E3E3E] dark:text-white transition-colors" title="Filtres & Tri">
            <i class='bx bx-slider-alt text-xl leading-none'></i>
        </button>

        <div id="suggestionsContainer"
            class="absolute z-20 w-full bg-white dark:bg-dark-bg border border-gray-200 dark:border-[#3E3E3E] rounded-xl mt-1 shadow-lg hidden max-h-60 overflow-auto">
        </div>
    </div>
</header>
<FiltersDrawer />
